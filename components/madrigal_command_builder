    display_name = "Madrigal Command Builder v5"
    description = (
        "Builds globalIsprint.py commands with metadata-aware instrument resolution. "
        "Uses local MadVI headers DB to avoid recommending instruments that do not contain requested parameters."
    )
    icon = "terminal"
    name = "MadrigalCommandBuilder"
    trace_type = "tool"

    inputs = [
        MessageTextInput(name="url", display_name="Madrigal URL", tool_mode=True),
        MessageTextInput(name="instrument", display_name="Instrument (name or id)", tool_mode=True),
        MessageTextInput(name="parms", display_name="Parms or science quantity", tool_mode=True),
        MessageTextInput(name="startDate", display_name="Start Date", tool_mode=True),
        MessageTextInput(name="endDate", display_name="End Date", tool_mode=True),
        MessageTextInput(name="format", display_name="Format (Hdf5|ascii|netCDF4)", tool_mode=True),
        MessageTextInput(name="output_path", display_name="Output directory (default /tmp)", tool_mode=True),
        MessageTextInput(name="user_fullname", display_name="User full name", tool_mode=True),
        MessageTextInput(name="user_email", display_name="User email", tool_mode=True),
        MessageTextInput(name="user_affiliation", display_name="User affiliation", tool_mode=True),
        MessageTextInput(name="sql_db_path", display_name="SQL DB Path optional", tool_mode=True),
        MessageTextInput(name="skip_optional", display_name="Skip optional info? (true/false)", tool_mode=True),
        MessageTextInput(name="debug", display_name="Debug (true/false)", tool_mode=True),
    ]

    outputs = [
        Output(display_name="Command", name="command", method="build_command"),
    ]

    def _get_sql_db_path(self) -> str:
        custom = _to_text(getattr(self, "sql_db_path", "")).strip()
        return custom or DEFAULT_SQL_DB_PATH

    def _score_madrigal_candidate(
        self,
        instrument_query: str,
        instrument_id: int,
        instrument_name: str,
        requested_codes: List[str],
        science_intents: List[str],
        startDate: str,
        endDate: str,
        db_path: str,
    ) -> Dict:
        q = _norm(instrument_query)
        q_tokens = _expand_aliases(set(_tokenize(instrument_query)))
        q_norm = _site_style_normalize(instrument_query)

        name_l = _norm(instrument_name)
        name_tokens = set(_tokenize(instrument_name))

        explicit_isr = (
            "isr" in q
            or "is radar" in q
            or "incoherent scatter radar" in q
            or "incoherent scatter" in q
            or "isradar" in q.replace(" ", "")
        )

        requested_density_or_temp = any(
            x in science_intents
            for x in ["electron_density", "ion_temperature", "electron_temperature"]
        ) or any(c in requested_codes for c in ["NE", "NEL", "TI", "TE"])

        requested_neutral_wind = _is_neutral_wind_request(science_intents, requested_codes)

        score = 0
        reasons = []

        overlap = q_tokens.intersection(name_tokens)

        if overlap:
            score += 220 + 45 * len(overlap)
            reasons.append(f"name overlap: {', '.join(sorted(overlap))}")

        if q and q in name_l:
            score += 350
            reasons.append("direct name substring")

        if q_norm and q_norm in name_l:
            score += 300
            reasons.append("normalized name substring")

        if "millstone" in q_tokens and "hill" in q_tokens and "millstone hill" in name_l:
            score += 500
            reasons.append("Millstone Hill site match")

        if explicit_isr and "is radar" in name_l:
            score += 4000
            reasons.append("explicit ISR/IS Radar match")

        if (
            requested_density_or_temp
            and "millstone" in q_tokens
            and "hill" in q_tokens
            and "millstone hill is radar" in name_l
        ):
            score += 3500
            reasons.append("density/temperature request at Millstone Hill strongly favors IS Radar")

        if "fabry" in name_l and requested_density_or_temp:
            score -= 2500
            reasons.append("Fabry-Perot deprioritized for electron-density/ISR temperature request")

        if "all-sky" in name_l and requested_density_or_temp:
            score -= 2500
            reasons.append("All-Sky Imager deprioritized for electron-density/ISR temperature request")

        if requested_neutral_wind and ("fabry" in name_l or "fpi" in name_l):
            score += 1800
            reasons.append("neutral wind request favors Fabry-Perot/FPI instruments when metadata supports them")

        if requested_neutral_wind and ("all-sky" in name_l or "imager" in name_l):
            score -= 2200
            reasons.append("All-Sky Imager deprioritized for neutral wind request")

        meta = _parameter_availability_for_instrument(
            db_path=db_path,
            instrument_id=instrument_id,
            requested_codes=requested_codes,
            start_mmddyyyy=startDate,
            end_mmddyyyy=endDate,
        )

        matched_codes = meta.get("matched_codes", [])
        file_count = meta.get("file_count", 0)

        if requested_codes and matched_codes:
            score += 2500 + 350 * len(matched_codes)
            score += min(file_count, 500)
            reasons.append(f"metadata contains requested codes: {', '.join(matched_codes)}")

        if requested_codes and not matched_codes and _db_usable(db_path):
            score -= 1800
            reasons.append("no requested parameter codes found for this instrument/date window in local metadata")

        return {
            "score": score,
            "id": instrument_id,
            "name": instrument_name,
            "metadata": meta,
            "reasons": reasons,
        }

    def _resolve_instrument_metadata_aware(
        self,
        url: str,
        instrument_clean: str,
        requested_codes: List[str],
        science_intents: List[str],
        startDate: str,
        endDate: str,
        db_path: str,
    ) -> Tuple[Optional[int], List[Dict], str]:
        if instrument_clean.isdigit():
            return int(instrument_clean), [], ""

        md = MadrigalData(url)
        inst_list = md.getAllInstruments()

        scored = []

        for inst in inst_list:
            inst_id, name = _extract_inst(inst)

            if inst_id is None or not name:
                continue

            cand = self._score_madrigal_candidate(
                instrument_query=instrument_clean,
                instrument_id=inst_id,
                instrument_name=name,
                requested_codes=requested_codes,
                science_intents=science_intents,
                startDate=startDate,
                endDate=endDate,
                db_path=db_path,
            )

            if cand["score"] > 0:
                scored.append(cand)

        scored.sort(key=lambda x: x["score"], reverse=True)

        if not scored:
            return None, [], (
                f"I couldn't resolve the instrument '{instrument_clean}' at {url}.\n"
                "Reply with a numeric inst id, e.g. 30, or a more specific instrument name."
            )

        top = scored[0]
        second = scored[1] if len(scored) > 1 else None

        supported = [
            c for c in scored
            if c.get("metadata", {}).get("matched_codes")
        ]

        if requested_codes and len(supported) == 1:
            return supported[0]["id"], scored[:10], ""

        if not second or (top["score"] - second["score"]) >= 700:
            return top["id"], scored[:10], ""

        top_has_meta = bool(top.get("metadata", {}).get("matched_codes"))
        second_has_meta = bool(second.get("metadata", {}).get("matched_codes"))

        if top_has_meta and not second_has_meta:
            return top["id"], scored[:10], ""

        candidates_to_show = supported[:8] if supported else scored[:8]

        lines = [
            f"Your instrument name is ambiguous: '{instrument_clean}'",
            "",
        ]

        if requested_codes and supported:
            lines.append(
                "I filtered candidates using the requested parameter codes "
                f"({', '.join(requested_codes)}) and the local metadata index."
            )
        elif requested_codes and not supported:
            lines.append(
                "I could not confirm parameter availability for the candidates in the local metadata index, "
                "so I need a numeric instrument ID."
            )

        lines.append("")
        lines.append("Candidate instruments:")

        for c in candidates_to_show:
            meta = c.get("metadata", {})
            codes = meta.get("matched_codes") or []
            file_count = meta.get("file_count") or 0
            code_note = f"contains {', '.join(codes)}; {file_count} matching indexed files" if codes else "parameter support not confirmed"
            lines.append(f"- {c['id']} — {c['name']} ({code_note})")

        excluded = [
            c for c in scored[:12]
            if requested_codes and not c.get("metadata", {}).get("matched_codes")
            and ("fabry" in c["name"].lower() or "all-sky" in c["name"].lower())
        ]

        if excluded:
            lines.append("")
            lines.append("Excluded from recommendation because they do not match the requested data product in the local metadata index:")
            for c in excluded[:5]:
                lines.append(f"- {c['id']} — {c['name']}")

        lines.append("")
        lines.append("Reply with the numeric instrument ID you want.")

        return None, scored[:10], "\n".join(lines)

    async def build_command(self) -> Message:
        url_raw = _to_text(self.url).strip()
        url = _normalize_url(url_raw)

        instrument_raw = _to_text(self.instrument).strip()
        instrument_clean = _clean_instrument_name(instrument_raw)

        parms_raw = _to_text(self.parms).strip()
        parms_norm, science_intents, parms_warning = _normalize_parms_freeform(parms_raw)
        requested_codes = _codes_from_parms_norm(parms_norm)

        start_raw = _to_text(self.startDate).strip()
        end_raw = _to_text(self.endDate).strip()
        startDate = _parse_date_to_mmddyyyy(start_raw)
        endDate = _parse_date_to_mmddyyyy(end_raw)

        fmt_raw = _to_text(self.format).strip()
        fmt = _normalize_format(fmt_raw)

        output_path_raw = _to_text(self.output_path).strip()
        output_path, output_path_note = _normalize_output_directory(output_path_raw)

        user_fullname = (_to_text(self.user_fullname).strip() or "")
        user_email_raw = (_to_text(self.user_email).strip() or "")
        m_email = re.search(r"[\w\.\-+]+@[\w\.\-]+\.\w+", user_email_raw)
        user_email = (m_email.group(0) if m_email else "")
        user_affiliation = (_to_text(self.user_affiliation).strip() or "")

        skip_optional = (_to_text(self.skip_optional).strip().lower() == "true")
        debug = (_to_text(self.debug).strip().lower() == "true")
        db_path = self._get_sql_db_path()

        if not instrument_clean:
            return Message(
                text=(
                    "Which Madrigal instrument should I use?\n"
                    "Example: Millstone Hill IS Radar, Millstone Hill ISR, or instrument 30."
                )
            )

        if (start_raw and not startDate) or (end_raw and not endDate):
            return Message(
                text=(
                    "I couldn't parse your date range.\n"
                    "Use either:\n"
                    "- 2025-01-01 to 2025-01-31\n"
                    "- January 1 2025 to January 31 2025\n"
                    "- 01/01/2025 to 01/31/2025"
                )
            )

        if not startDate or not endDate:
            return Message(text="What date range do you want? Example: 2025-01-01 to 2025-01-31.")

        if not fmt:
            return Message(text="Which output format do you want? Reply with: HDF5, ASCII, or netCDF4.")

        if not parms_norm:
            return Message(
                text=(
                    "What data product or Madrigal parameter codes do you want?\n"
                    "Examples:\n"
                    "- electron density\n"
                    "- gdalt,ne,ti,te\n"
                    "- TEC"
                )
            )

        if parms_norm == "__NEEDS_EXACT_MADRIGAL_CODES__":
            return Message(
                text=(
                    "I could not safely map that data product to Madrigal parameter codes.\n"
                    "Try a recognized quantity such as electron density, ion temperature, electron temperature, altitude, or TEC.\n"
                    "Or provide exact Madrigal parameter codes, comma-separated."
                )
            )

        if not skip_optional:
            missing = []

            if not user_fullname:
                missing.append("full name")
            if not user_email:
                missing.append("email")
            if not user_affiliation:
                missing.append("affiliation")

            if missing:
                return Message(
                    text=(
                        "Before I generate the runnable command, do you want to include optional user info?\n"
                        f"Missing: {', '.join(missing)}\n\n"
                        "You can reply with any of these:\n"
                        "- name: Your Name\n"
                        "- email: you@domain.com\n"
                        "- affiliation: Your Org\n"
                        "- output directory: /your/writable/directory (optional; default /tmp)\n\n"
                        "Or reply: skip"
                    )
                )

        # Deployment-safe defaults. Never inherit previous users.
        if not user_fullname:
            user_fullname = "Unknown User"
        if not user_email:
            user_email = "unknown@example.com"
        if not user_affiliation:
            user_affiliation = "None"

        param_presence = _db_global_param_presence(db_path, requested_codes)

        missing_requested_codes = [
            code for code in requested_codes
            if _db_usable(db_path) and param_presence.get(code, 0) == 0
        ]

        # Metadata-aware guardrail for beginner users:
        # If a recognized data product has no matching files for the requested site/date,
        # do not fabricate a command that is likely to return empty data.
        if _db_usable(db_path) and requested_codes:
            site_matches_now = _site_parameter_matches(
                db_path=db_path,
                instrument_text=instrument_clean,
                requested_codes=requested_codes,
                start_mmddyyyy=startDate,
                end_mmddyyyy=endDate,
                limit=8,
            )

            if not site_matches_now and science_intents:
                historical = _site_parameter_historical_matches(
                    db_path=db_path,
                    instrument_text=instrument_clean,
                    requested_codes=requested_codes,
                    limit=8,
                )

                lines = [
                    "[Command]",
                    "I recognized the requested data product, but the local MadVI metadata index did not confirm any matching files for that site/date window.",
                    "",
                    f"Detected data product intent: {_pretty_intents(science_intents)}.",
                    f"Mapped Madrigal parameter codes: {', '.join(requested_codes)}.",
                    f"Requested instrument/site: {instrument_clean}",
                    f"Requested date range: {startDate} to {endDate}",
                    "",
                    "I will not fabricate a globalIsprint.py command that is likely to return empty data.",
                ]

                if historical:
                    lines.append("")
                    lines.append("Closest matching availability for this site/data product in the local index:")
                    for h in historical[:6]:
                        lines.append(
                            f"- {h['instrument_code_s']} — {h['instrument']} "
                            f"contains {', '.join(h['matched_codes'])}; "
                            f"{h['file_count']} indexed files; "
                            f"{h['first_time_utc']} to {h['last_time_utc']}"
                        )
                    lines.append("")
                    lines.append("Try a date range inside one of those availability windows, or provide a numeric instrument ID if you intentionally want to force the command.")
                else:
                    lines.append("")
                    lines.append("No historical match for those parameter codes was found at that site in the local index.")
                    lines.append("Try exact Madrigal parameter codes, a broader site/instrument name, or a different date range.")

                return Message(text="\n".join(lines))

        try:
            inst_id, inst_debug, blocked_message = self._resolve_instrument_metadata_aware(
                url=url,
                instrument_clean=instrument_clean,
                requested_codes=requested_codes,
                science_intents=science_intents,
                startDate=startDate,
                endDate=endDate,
                db_path=db_path,
            )

            if blocked_message:
                return Message(text=blocked_message)

            if inst_id is None:
                return Message(
                    text=(
                        f"I couldn't resolve the instrument '{instrument_raw}'.\n"
                        "Reply with a numeric instrument ID, e.g. 30."
                    )
                )

        except Exception as e:
            return Message(
                text=(
                    "I hit an error while resolving the instrument.\n"
                    f"Site: {url}\n"
                    f"Error: {type(e).__name__}: {e}\n"
                    "Try again, or reply with a numeric instrument ID."
                )
            )

        parms_part = f" --parms={parms_norm}" if parms_norm else ""

        cmd = (
            "globalIsprint.py --verbose "
            f"--url={url}"
            f"{parms_part} "
            f"--output={_safe_shell_quote(output_path)} "
            f"--user_fullname={_safe_shell_quote(user_fullname)} "
            f"--user_email={_safe_shell_quote(user_email)} "
            f"--user_affiliation={_safe_shell_quote(user_affiliation)} "
            f'--startDate="{startDate}" --endDate="{endDate}" '
            f"--inst={inst_id} --format={fmt}"
        )

        notes = []

        if output_path_note:
            notes.append(output_path_note)

        if science_intents:
            notes.append(
                "Detected data product intent: "
                f"{_pretty_intents(science_intents)}."
            )

        if requested_codes:
            notes.append(f"Using Madrigal parameter codes: {parms_norm}.")

        if missing_requested_codes:
            notes.append(
                "Warning: the local MadVI metadata index did not contain these requested codes anywhere: "
                + ", ".join(missing_requested_codes)
                + ". They are kept in the command because the user explicitly requested them, "
                "but Madrigal may return no values for those parameters for this instrument/date range."
            )

        chosen_meta = _parameter_availability_for_instrument(
            db_path=db_path,
            instrument_id=inst_id,
            requested_codes=requested_codes,
            start_mmddyyyy=startDate,
            end_mmddyyyy=endDate,
        )

        if chosen_meta.get("matched_codes"):
            notes.append(
                "Local metadata check: selected instrument has indexed files containing "
                f"{', '.join(chosen_meta['matched_codes'])} "
                f"for the requested time window "
                f"({chosen_meta.get('file_count', 0)} matching indexed files)."
            )
        elif _db_usable(db_path) and requested_codes:
            notes.append(
                "Local metadata check: no indexed files confirmed the requested parameter codes "
                "for this instrument/date window. The command is still generated, but verify the returned file."
            )

        if inst_debug:
            top = inst_debug[0]
            excluded_bad = [
                c for c in inst_debug
                if requested_codes
                and not c.get("metadata", {}).get("matched_codes")
                and ("fabry" in c["name"].lower() or "all-sky" in c["name"].lower())
            ]

            notes.append(f"Resolved instrument: {top['id']} — {top['name']}.")

            if excluded_bad:
                notes.append(
                    "Not recommended for this data product: "
                    + "; ".join(f"{c['id']} — {c['name']}" for c in excluded_bad[:3])
                    + "."
                )

        if not _db_usable(db_path):
            notes.append(
                "Local metadata index was unavailable, so instrument resolution used Madrigal site names only."
            )

        response = (
            "[Command]\n"
            "Runnable globalIsprint.py command:\n\n"
            "```bash\n"
            f"{cmd}\n"
            "```"
        )

        if notes:
            response += "\n\n" + "\n".join(f"- {n}" for n in notes)

        if debug:
            dbg = [
                "",
                "DEBUG:",
                f"  url_raw: {url_raw}",
                f"  url_normalized: {url}",
                f"  db_usable: {_db_usable(db_path)}",
                f"  db_coverage: {_db_coverage_summary(db_path)}",
                f"  instrument_raw: {instrument_raw}",
                f"  instrument_clean: {instrument_clean}",
                f"  resolved_inst_id: {inst_id}",
                f"  parms_raw: {parms_raw}",
                f"  parms_normalized: {parms_norm}",
                f"  science_intents: {science_intents}",
                f"  requested_codes: {requested_codes}",
                f"  start_raw: {start_raw}",
                f"  end_raw: {end_raw}",
                f"  startDate_mmddyyyy: {startDate}",
                f"  endDate_mmddyyyy: {endDate}",
                f"  format_raw: {fmt_raw}",
                f"  format_norm: {fmt}",
                f"  output_path_raw: {output_path_raw}",
                f"  output_directory_normalized: {output_path}",
                f"  output_path_note: {output_path_note}",
                f"  skip_optional: {skip_optional}",
                "  top_candidates:",
            ]

            for c in inst_debug[:10]:
                meta = c.get("metadata", {})
                dbg.append(
                    f"    score={c['score']} id={c['id']} name={c['name']} "
                    f"matched_codes={meta.get('matched_codes')} file_count={meta.get('file_count')} "
                    f"reasons={'; '.join(c.get('reasons', []))}"
                )

            response += "\n\n```text\n" + "\n".join(dbg) + "\n```"

        self.status = response
        return Message(text=response)
