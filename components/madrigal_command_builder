}


def _detect_science_intents(text: str) -> List[str]:
    q = _norm(text)
    intents = []

    if (
        "electron density" in q
        or re.search(r"\bne\b", q)
        or re.search(r"\bnel\b", q)
        or "density" in q
    ):
        intents.append("electron_density")

    if "ion temperature" in q or re.search(r"\bti\b", q):
        intents.append("ion_temperature")

    if "electron temperature" in q or re.search(r"\bte\b", q):
        intents.append("electron_temperature")

    if "altitude" in q or "height" in q or re.search(r"\bgdalt\b", q):
        intents.append("geodetic_altitude")

    if "total electron content" in q or "electron content" in q or re.search(r"\btec\b", q):
        intents.append("total_electron_content")

    if "line of sight velocity" in q or re.search(r"\bvo\b", q):
        intents.append("line_of_sight_velocity")

    if "ion velocity" in q or re.search(r"\bvi\b", q):
        intents.append("ion_velocity")

    if (
        "neutral wind" in q
        or "neutral winds" in q
        or "thermospheric wind" in q
        or "thermospheric winds" in q
        or re.search(r"\bvn1\b", q)
        or re.search(r"\bvn2\b", q)
        or re.search(r"\bvn31\b", q)
    ):
        intents.append("neutral_wind")

    if "zonal wind" in q or "eastward wind" in q:
        intents.append("neutral_wind")

    if "meridional wind" in q or "northward wind" in q:
        intents.append("neutral_wind")

    if "vertical wind" in q or "upward wind" in q:
        intents.append("neutral_wind")

    seen = []
    for item in intents:
        if item not in seen:
            seen.append(item)

    return seen


def _looks_like_madrigal_code(token: str) -> bool:
    return bool(re.fullmatch(r"[A-Z][A-Z0-9_+\-]{0,11}", token or ""))


def _normalize_parms_freeform(parms_raw: str) -> Tuple[str, List[str], str]:
    """
    Returns:
      normalized comma-separated parameter codes,
      science intent labels,
      warning/status string.
    """
    s = (parms_raw or "").strip()

    if not s:
        return "", [], ""

    intents = _detect_science_intents(s)
    codes = []

    # Defensive local fallback:
    # Langflow sometimes caches/evaluates helper functions in a way that can lose
    # module-level globals after a custom-component edit. This prevents
    # NameError: SCIENCE_ALIAS_TO_CODES is not defined.
    alias_to_codes = globals().get(
        "SCIENCE_ALIAS_TO_CODES",
        {
            "electron_density": ["NE", "NEL"],
            "ion_temperature": ["TI"],
            "electron_temperature": ["TE"],
            "geodetic_altitude": ["GDALT"],
            "total_electron_content": ["TEC"],
            "line_of_sight_velocity": ["VO"],
            "ion_velocity": ["VI", "VO"],
            "plasma_frequency": ["POPL"],
            "neutral_wind": ["VN1", "VN2", "VN31"],
            "neutral_wind_errors": ["DVN1", "DVN2", "DVN31"],
            "magnetic_meridional_neutral_wind": ["UMER"],
        },
    )

    for intent in intents:
        for code in alias_to_codes.get(intent, []):
            if code not in codes:
                codes.append(code)

    parts = re.split(r"[,\s]+", s)
    explicit_codes = []

    for p in parts:
        p = p.strip().upper()
        if not p:
            continue
        if _looks_like_madrigal_code(p):
            explicit_codes.append(p)

    prose_words = {
        "ELECTRON", "DENSITY", "ION", "TEMPERATURE", "TEMP", "TOTAL",
        "CONTENT", "ALTITUDE", "HEIGHT", "DATA", "PARAMETER", "PARAMETERS",
        "NEUTRAL", "WIND", "WINDS", "ZONAL", "MERIDIONAL", "VERTICAL",
        "THERMOSPHERIC", "EASTWARD", "NORTHWARD", "UPWARD",
    }

    if explicit_codes and not all(p in prose_words for p in explicit_codes):
        for code in explicit_codes:
            if code not in codes and code not in prose_words:
                codes.append(code)

    if not codes:
        return "__NEEDS_EXACT_MADRIGAL_CODES__", intents, (
            "Madrigal needs short parameter codes or a recognized science quantity."
        )

    return ",".join(codes), intents, ""


def _codes_from_parms_norm(parms_norm: str) -> List[str]:
    if not parms_norm or parms_norm.startswith("__"):
        return []
    return [p.strip().upper() for p in parms_norm.split(",") if p.strip()]


