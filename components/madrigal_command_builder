def _parse_single_numeric_instrument_code(code_s: str) -> Optional[int]:
    if not code_s:
        return None
    parts = [p.strip() for p in str(code_s).split(",") if p.strip()]
    if len(parts) != 1:
        return None
    return int(parts[0]) if parts[0].isdigit() else None


def _is_neutral_wind_request(science_intents: List[str], requested_codes: List[str]) -> bool:
    return "neutral_wind" in science_intents or any(c in {"VN1", "VN2", "VN31", "UMER"} for c in requested_codes)


