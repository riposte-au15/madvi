def _to_text(x) -> str:
    if isinstance(x, Message):
        return x.text or ""
    return str(x or "")


def _clean_space(text: str) -> str:
    return re.sub(r"\s+", " ", str(text or "").strip())


def _norm(text: str) -> str:
    return _clean_space(text).lower()


def _extract_first_url(s: str) -> str:
    s = (s or "").strip()
    m = re.search(r"https?://[^\s\"']+", s)
    return m.group(0) if m else ""


def _normalize_url(url: str) -> str:
    url = (url or "").strip().strip('"').strip("'")
    extracted = _extract_first_url(url)

    if extracted:
        url = extracted

    if not url:
        url = DEFAULT_MADRIGAL_URL

    url = re.sub(r"(https?://[^/]+)(/.*)?$", r"\1/", url)

    if not url.endswith("/"):
        url += "/"

    return url


def _clean_instrument_name(instr: str) -> str:
    instr = (instr or "").strip()
    instr = re.sub(r"\[[^\]]*\]", "", instr)
    instr = re.sub(r"\s+", " ", instr).strip()
    return instr


def _tokenize(s: str) -> List[str]:
    s = re.sub(r"[^a-z0-9]+", " ", (s or "").lower()).strip()
    return [t for t in s.split() if t]


def _expand_aliases(tokens: set) -> set:
    aliases = {
        "is": ["incoherent", "scatter", "radar"],
        "iscat": ["incoherent", "scatter", "radar"],
        "isr": ["incoherent", "scatter", "radar"],
        "uhf": ["uhf"],
        "vhf": ["vhf"],
        "hf": ["hf"],
        "radar": ["radar"],
        "tec": ["total", "electron", "content"],
        "density": ["electron", "density"],
        "ne": ["electron", "density"],
        "nel": ["electron", "density"],
        "temp": ["temperature"],
        "wind": ["neutral", "wind"],
        "winds": ["neutral", "wind"],
        "neutral": ["neutral"],
        "zonal": ["eastward", "wind"],
        "meridional": ["northward", "wind"],
        "vertical": ["up", "wind"],
    }

    expanded = set(tokens)

    for t in list(tokens):
        if t in aliases:
            expanded.update(aliases[t])

    return expanded


def _site_style_normalize(name: str) -> str:
    s = (name or "").lower()
    s = re.sub(r"\[[^\]]*\]", "", s)

    s = s.replace("incoherent scatter radar", "radar")
    s = s.replace("incoherent scatter", "")
    s = s.replace("incoherent", "")
    s = s.replace("scatter", "")
    s = s.replace("is radar", "radar")
    s = re.sub(r"\bis\b", "", s)

    s = re.sub(r"\s+", " ", s).strip()
    return s


def _extract_inst(inst) -> Tuple[Optional[int], Optional[str]]:
    code = getattr(inst, "code", None)
    name = getattr(inst, "name", None)

    if code is not None and name is not None:
        try:
            return int(code), str(name)
        except Exception:
            pass

    try:
        return int(inst[0]), str(inst[1])
    except Exception:
        return None, None


def _strip_ordinal(s: str) -> str:
    return re.sub(r"(\d+)(st|nd|rd|th)\b", r"\1", (s or ""), flags=re.IGNORECASE)


def _parse_date_to_mmddyyyy(s: str) -> str:
    s = (s or "").strip().strip('"').strip("'")

    if not s:
        return ""

    s = _strip_ordinal(s)
    s = re.sub(r"\s+", " ", s).strip()

    if re.fullmatch(r"\d{1,2}/\d{1,2}/\d{4}", s):
        mm, dd, yyyy = s.split("/")
        return f"{int(mm):02d}/{int(dd):02d}/{int(yyyy):04d}"

    m = re.fullmatch(r"(\d{4})[-/](\d{1,2})[-/](\d{1,2})", s)

    if m:
        yyyy, mm, dd = m.groups()
        return f"{int(mm):02d}/{int(dd):02d}/{int(yyyy):04d}"

    for fmt in (
        "%B %d %Y",
        "%b %d %Y",
        "%B %d, %Y",
        "%b %d, %Y",
    ):
        try:
            dt = datetime.strptime(s, fmt)
            return dt.strftime("%m/%d/%Y")
        except Exception:
            pass

    if re.search(r"\d{5,}", s):
        return ""

    return ""


def _mmddyyyy_to_iso_year(mmddyyyy: str) -> Optional[int]:
    try:
        return datetime.strptime(mmddyyyy, "%m/%d/%Y").year
    except Exception:
        return None


def _safe_shell_quote(s: str) -> str:
    s = str(s or "")
    s = s.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{s}"'


def _normalize_output_directory(output_raw: str) -> Tuple[str, str]:
    """
    Normalize globalIsprint.py --output as a writable DIRECTORY.

    Rules:
      - If omitted or blank, always use /tmp.
      - If a filename-like value is supplied without a directory, use /tmp.
      - If a full file path is supplied, use its parent directory.
      - If a directory is supplied, preserve it.

    Returns:
      (normalized_directory, user-facing_note)
    """
    raw = str(output_raw or "").strip().strip('"').strip("'")

    if not raw:
        return (
            DEFAULT_OUTPUT_DIR,
            "Output directory defaulted to /tmp because no output directory was specified.",
        )

    if raw.lower() in {"tmp", "/tmp", "$tmp", "${tmp}"}:
        return DEFAULT_OUTPUT_DIR, ""

    file_extensions = {
        ".hdf5", ".h5", ".hdf", ".nc", ".nc4", ".netcdf",
        ".txt", ".csv", ".dat", ".json", ".zip",
    }

    normalized_for_split = raw.replace("\\", "/")
    basename = normalized_for_split.rsplit("/", 1)[-1]
    suffix = os.path.splitext(basename)[1].lower()

    if suffix in file_extensions:
        if "/" in normalized_for_split:
            parent = normalized_for_split.rsplit("/", 1)[0].strip()

            if "\\" in raw and "/" not in raw:
                parent = parent.replace("/", "\\")

            if parent:
                return (
                    parent,
                    "globalIsprint.py expects a writable directory, so the supplied file path "
                    f"was normalized to its parent directory: {parent}.",
                )

        return (
            DEFAULT_OUTPUT_DIR,
            "globalIsprint.py expects a writable directory, not a filename. "
            "The file-like output value was replaced with the default directory /tmp.",
        )

    return raw, ""


def _normalize_format(fmt_in: str) -> str:
    fmt_in = (fmt_in or "").strip()

    if not fmt_in:
        return ""

    fmt_map = {
        "hdf5": "Hdf5",
        "h5": "Hdf5",
        "ascii": "ascii",
        "txt": "ascii",
        "netcdf4": "netCDF4",
        "netcdf": "netCDF4",
        "nc": "netCDF4",
    }

    return fmt_map.get(fmt_in.lower(), fmt_in)


