def _db_usable(db_path: str) -> bool:
    if not db_path:
        return False
    if not os.path.exists(db_path):
        return False

    try:
        conn = sqlite3.connect(db_path)
        try:
            cur = conn.cursor()
            cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('files','parameters')")
            tables = {r[0] for r in cur.fetchall()}
            return "files" in tables and "parameters" in tables
        finally:
            conn.close()
    except Exception:
        return False


def _fetch_sql(db_path: str, sql: str, params: tuple = ()) -> List[tuple]:
    conn = sqlite3.connect(db_path)
    try:
        cur = conn.cursor()
        cur.execute(sql, params)
        return cur.fetchall()
    finally:
        conn.close()


def _date_year_range(start_mmddyyyy: str, end_mmddyyyy: str) -> Tuple[Optional[int], Optional[int]]:
    return _mmddyyyy_to_iso_year(start_mmddyyyy), _mmddyyyy_to_iso_year(end_mmddyyyy)


def _metadata_year_clause(start_year: Optional[int], end_year: Optional[int]) -> Tuple[str, Tuple]:
    if start_year is None or end_year is None:
        return "", tuple()

    y1, y2 = min(start_year, end_year), max(start_year, end_year)

    return (
        """
        AND (
            (f.start_year IS NOT NULL AND f.end_year IS NOT NULL AND f.start_year <= ? AND f.end_year >= ?)
            OR (
                f.start_year IS NULL
                AND SUBSTR(f.start_time_utc, 1, 4) <= ?
                AND SUBSTR(f.end_time_utc, 1, 4) >= ?
            )
        )
        """,
        (y2, y1, str(y2), str(y1)),
    )


def _parameter_availability_for_instrument(
    db_path: str,
    instrument_id: int,
    requested_codes: List[str],
    start_mmddyyyy: str,
    end_mmddyyyy: str,
) -> Dict:
    out = {
        "matched_codes": [],
        "available_codes": [],
        "file_count": 0,
        "first_time_utc": None,
        "last_time_utc": None,
    }

    if not _db_usable(db_path):
        return out

    if not requested_codes:
        return out

    start_year, end_year = _date_year_range(start_mmddyyyy, end_mmddyyyy)
    year_clause, year_params = _metadata_year_clause(start_year, end_year)
    placeholders = ",".join(["?"] * len(requested_codes))

    rows = _fetch_sql(
        db_path,
        f"""
        SELECT
            UPPER(p.mnemonic) AS mnemonic,
            COUNT(DISTINCT f.file_index) AS file_count,
            MIN(f.start_time_utc) AS first_time_utc,
            MAX(f.end_time_utc) AS last_time_utc
        FROM files f
        JOIN parameters p ON p.file_index = f.file_index
        WHERE (
            ',' || REPLACE(f.instrument_code_s, ' ', '') || ',' LIKE ?
            OR EXISTS (
                SELECT 1
                FROM file_instruments fi
                WHERE fi.file_index = f.file_index
                AND fi.instrument_code = ?
            )
        )
        AND UPPER(p.mnemonic) IN ({placeholders})
        {year_clause}
        GROUP BY UPPER(p.mnemonic)
        ORDER BY UPPER(p.mnemonic)
        """,
        (f"%,{instrument_id},%", instrument_id) + tuple(requested_codes) + tuple(year_params),
    )

    matched_codes = []
    file_count_total = 0
    firsts = []
    lasts = []

    for mnemonic, file_count, first_time, last_time in rows:
        if mnemonic:
            matched_codes.append(str(mnemonic).upper())
        file_count_total += int(file_count or 0)
        if first_time:
            firsts.append(first_time)
        if last_time:
            lasts.append(last_time)

    out["matched_codes"] = sorted(set(matched_codes))
    out["available_codes"] = sorted(set(matched_codes))
    out["file_count"] = file_count_total
    out["first_time_utc"] = min(firsts) if firsts else None
    out["last_time_utc"] = max(lasts) if lasts else None

    return out


def _db_global_param_presence(db_path: str, requested_codes: List[str]) -> Dict[str, int]:
    if not _db_usable(db_path) or not requested_codes:
        return {}

    placeholders = ",".join(["?"] * len(requested_codes))

    rows = _fetch_sql(
        db_path,
        f"""
        SELECT UPPER(mnemonic), COUNT(DISTINCT file_index)
        FROM parameters
        WHERE UPPER(mnemonic) IN ({placeholders})
        GROUP BY UPPER(mnemonic)
        """,
        tuple(requested_codes),
    )

    return {str(k).upper(): int(v or 0) for k, v in rows}


def _db_coverage_summary(db_path: str) -> str:
    if not _db_usable(db_path):
        return "local metadata index unavailable"

    try:
        rows = _fetch_sql(
            db_path,
            """
            SELECT MIN(start_time_utc), MAX(start_time_utc), COUNT(DISTINCT file_index)
            FROM files
            """
        )
        if not rows:
            return "local metadata index has no files"

        earliest, latest, count = rows[0]
        return f"{earliest} to {latest} ({count} indexed files)"
    except Exception:
        return "local metadata index coverage unavailable"


def _site_like_clause_from_instrument_text(instrument_text: str) -> Tuple[str, Tuple[str, ...]]:
    """Build a safe SQL site/instrument filter from a user instrument phrase.

    It intentionally focuses on strong site tokens such as "millstone" and "hill".
    If no useful token is available, it returns a broad true clause.
    """
    tokens = [t for t in _tokenize(instrument_text) if len(t) >= 3]
    stop = {
        "the", "and", "for", "data", "instrument", "radar", "isr", "incoherent",
        "scatter", "measurements", "measurement", "neutral", "electron", "density",
        "temperature", "wind", "winds", "ion", "uhf", "vhf", "hdf5", "ascii",
    }
    useful = [t for t in tokens if t not in stop]

    # Prefer site names when present.
    if "millstone" in tokens:
        useful = ["millstone"]
    elif "poker" in tokens and "flat" in tokens:
        useful = ["poker", "flat"]
    elif "jicamarca" in tokens:
        useful = ["jicamarca"]
    elif "arecibo" in tokens:
        useful = ["arecibo"]
    elif "sondrestrom" in tokens or "sondrestromfjord" in tokens:
        useful = ["sondrestrom"]

    if not useful:
        return "1=1", tuple()

    parts = []
    params = []
    for tok in useful[:3]:
        parts.append("LOWER(f.instrument) LIKE ?")
        params.append(f"%{tok}%")

    return " AND ".join(parts), tuple(params)


def _site_parameter_matches(
    db_path: str,
    instrument_text: str,
    requested_codes: List[str],
    start_mmddyyyy: str,
    end_mmddyyyy: str,
    limit: int = 12,
) -> List[Dict]:
    """Return instruments at the requested site that contain requested codes in the date/year window."""
    if not _db_usable(db_path) or not requested_codes:
        return []

    start_year, end_year = _date_year_range(start_mmddyyyy, end_mmddyyyy)
    year_clause, year_params = _metadata_year_clause(start_year, end_year)
    site_clause, site_params = _site_like_clause_from_instrument_text(instrument_text)
    placeholders = ",".join(["?"] * len(requested_codes))

    rows = _fetch_sql(
        db_path,
        f"""
        SELECT
            f.instrument_code_s,
            f.instrument,
            GROUP_CONCAT(DISTINCT UPPER(p.mnemonic)) AS matched_codes,
            COUNT(DISTINCT f.file_index) AS file_count,
            MIN(f.start_time_utc) AS first_time_utc,
            MAX(f.end_time_utc) AS last_time_utc
        FROM files f
        JOIN parameters p ON p.file_index = f.file_index
        WHERE {site_clause}
        AND UPPER(p.mnemonic) IN ({placeholders})
        {year_clause}
        GROUP BY f.instrument_code_s, f.instrument
        ORDER BY file_count DESC, f.instrument
        LIMIT ?
        """,
        tuple(site_params) + tuple(requested_codes) + tuple(year_params) + (limit,),
    )

    out = []
    for code_s, instrument, codes, file_count, first_time, last_time in rows:
        out.append({
            "instrument_code_s": code_s,
            "instrument": instrument,
            "matched_codes": sorted(set(str(codes or "").split(","))) if codes else [],
            "file_count": int(file_count or 0),
            "first_time_utc": first_time,
            "last_time_utc": last_time,
        })
    return out


def _site_parameter_historical_matches(
