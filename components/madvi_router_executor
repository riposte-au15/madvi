def _is_madrigal_scope_query(query: str) -> bool:
    """
    Universal domain boundary for the single-tool MadVI architecture.

    The goal is deliberately broader than the internal routing rules: this function
    answers only one question -- is the request meaningfully inside MadVI's Madrigal /
    geospace scientific domain?  If yes, the existing router is left completely in
    charge of choosing Docs, Papers, SQL, or Citation.

    Important design rule:
    - Do not add topic-specific OUT-OF-SCOPE deny rules (food, sports, etc.).
    - Instead, require positive evidence that the query belongs to Madrigal or to one
      of the scientific concepts/workflows that MadVI actually supports.
    """
    q = _norm(query).replace("-", " ")
    if not q:
        return False

    # 1) Direct Madrigal / CEDAR ecosystem and supported workflow signals.
    direct_terms = [
        "madrigal",
        "openmadrigal",
        "cedar database",
        "cedar madrigal",
        "madrigalweb",
        "madrigaldata",
        "globaldownload",
        "globalisprint",
        "globalcitation",
        "getexperiments",
        "getexperimentfiles",
        "insttab",
        "exptab",
        "filetab",
        "parmcodes",
        "parmcode",
        "madrigal citation",
        "citation group",
        "persistent citation",
        "citable madrigal",
    ]
    if _contains_any(q, direct_terms):
        return True

    # 2) Madrigal sites / instruments that are explicitly supported by the router.
    site_and_instrument_terms = [
        "millstone hill",
        "jicamarca",
        "arecibo",
        "poker flat",
        "sondrestrom",
        "fabry perot",
        "fabry-perot",
        "incoherent scatter",
        "is radar",
        "isr",
        "dmsp",
    ]
    if _contains_any(q, site_and_instrument_terms):
        return True

    # 3) Scientific concepts represented in the Madrigal / MadVI data and paper
    #    collections.  These allow natural queries that do not literally say
    #    "Madrigal", e.g. "find papers about ionospheric electron density".
    science_terms = [
        "geospace",
        "ionosphere",
        "ionospheric",
        "thermosphere",
        "thermospheric",
        "magnetosphere",
        "magnetospheric",
        "geomagnetic",
        "space weather",
        "electron density",
        "electron temperature",
        "ion temperature",
        "ion drift",
        "neutral wind",
        "total electron content",
        "traveling ionospheric disturbance",
        "travelling ionospheric disturbance",
        "mstid",
        "mstids",
        "saps",
        "substorm",
        "sar arc",
        "solar radio flux",
        "sunspot number",
    ]
    if _contains_any(q, science_terms):
        return True

    # 4) Supported space-weather observables.  These are intentionally accepted even
    #    without the word Madrigal because space_weather.db is an explicit MadVI data
    #    source and the current executor already supports standalone and joined queries.
    if (
        re.search(r"\bkp\b", q)
        or re.search(r"\bf10\.?7\b", q)
        or re.search(r"\bf107\b", q)
        or re.search(r"\bdst\b", q)
    ):
        return True

    # Ap/ap and SN are short/ambiguous tokens, so require surrounding scientific or
    # data-query language rather than accepting them everywhere.
    if re.search(r"\bap\b", q) and re.search(
        r"\b(?:index|geomagnetic|space weather|daily|3 hour|three hour|kp|data|value|values)\b",
        q,
    ):
        return True
    if re.search(r"\bsn\b", q) and re.search(
        r"\b(?:sunspot|solar|space weather|data|value|values)\b",
        q,
    ):
        return True

    # 5) Madrigal parameter mnemonics.  Longer/specific mnemonics are safe enough to
    #    accept directly.  Very short mnemonics are accepted only when the surrounding
    #    query looks like a scientific metadata/data request.
    specific_mnemonics = [
        "gdalt", "gdlat", "gdlon", "glon", "range", "azm", "elm",
        "popl", "dpop", "vn1", "vn2", "vn31", "tec",
    ]
    if any(re.search(rf"\b{re.escape(m)}\b", q) for m in specific_mnemonics):
        return True

    short_mnemonic = bool(re.search(r"\b(?:ne|nel|ti|te|vo|vi)\b", q))
    metadata_context = bool(re.search(
        r"\b(?:parameter|parameters|mnemonic|mnemonics|data|file|files|dataset|datasets|"
        r"measurement|measurements|instrument|instruments|available|availability|coverage|"
        r"definition|definitions|units?|days?|records?|radar)\b",
        q,
    ))
    if short_mnemonic and metadata_context:
        return True

    # 6) Explicit Madrigal-style instrument IDs used together with data/metadata language.
    if _extract_explicit_instrument_ids(query) and metadata_context:
        return True

    # No positive Madrigal/geospace signal: reject instead of falling through to the
    # generic documentation route.  This is what blocks unrelated prompts such as
    # recipes, sports, travel, coding questions unrelated to Madrigal, etc.
    return False


def _extract_email(text: str) -> str:
    m = re.search(r"[\w\.\-+]+@[\w\.\-]+\.\w+", text or "")
    return m.group(0) if m else ""


def _normalize_url(url: str) -> str:
    url = (url or DEFAULT_MADRIGAL_URL).strip().strip('"').strip("'")
    m = re.search(r"https?://[^\s\"']+", url)
    if m:
        url = m.group(0)
    url = re.sub(r"(https?://[^/]+)(/.*)?$", r"\1/", url)
    if not url.endswith("/"):
        url += "/"
    return url


def _is_citation_action_query(query: str) -> bool:
    q = _norm(query)

    has_citation = any(x in q for x in [
        "madrigal citation",
        "citation group",
        "persistent citation",
        "permanent citation",
        "citable madrigal",
        "citable url",
    ])

    has_action = any(x in q for x in [
        "create",
        "make",
        "generate",
        "build",
        "dry run",
        "dry-run",
        "real citation",
        "not a dry run",
        "not dry run",
        "not dry-run",
        "actually create",
        "permanent",
    ])

    has_dates = bool(re.search(r"\b(?:19|20)\d{2}-\d{2}-\d{2}\b", q))

    return has_citation and has_action and has_dates


def _parse_dates(query: str) -> Tuple[Optional[str], Optional[str]]:
    q = query or ""

    m = re.search(
        r"from\s+(\d{4}-\d{2}-\d{2})\s+(?:to|through|until|-)\s+(\d{4}-\d{2}-\d{2})",
        q,
        flags=re.I,
    )
    if m:
        return m.group(1), m.group(2)

    dates = [m.group(0) for m in re.finditer(r"\b(?:19|20)\d{2}-\d{2}-\d{2}\b", q)]
    if len(dates) >= 2:
        return dates[0], dates[1]

    return None, None


def _parse_date(s: str) -> datetime:
    return datetime.strptime((s or "").strip(), "%Y-%m-%d")


def _extract_explicit_instrument_ids(text: str) -> List[int]:
    patterns = [
        r"\binstrument\s*id\s*[:=]?\s*(\d{1,6})\b",
        r"\binstrument\s*[:=]?\s*(\d{1,6})\b",
        r"\binst\s*[:=]?\s*(\d{1,6})\b",
        r"\bkinst\s*[:=]?\s*(\d{1,6})\b",
    ]

    ids = []
    for pat in patterns:
        for m in re.finditer(pat, text or "", flags=re.I):
            val = int(m.group(1))
            if val not in ids:
                ids.append(val)

    return ids


def _extract_instrument_text(query: str) -> str:
    q = query or ""

    ids = _extract_explicit_instrument_ids(q)
    if ids:
        return ",".join(str(x) for x in ids)

    patterns = [
        r"citation\s+for\s+(.+?)\s+data\s+from\s+\d{4}-\d{2}-\d{2}",
        r"citation\s+for\s+(.+?)\s+from\s+\d{4}-\d{2}-\d{2}",
        r"for\s+(.+?)\s+data\s+from\s+\d{4}-\d{2}-\d{2}",
        r"instrument\s*[:=]\s*(.+?)(?:;|,|from\s+\d{4}-\d{2}-\d{2}|$)",
    ]

    for pat in patterns:
        m = re.search(pat, q, flags=re.I)
        if m:
            val = _clean_space(m.group(1))
            val = re.sub(r"\bdata\b$", "", val, flags=re.I).strip()
            return val

    return ""


def _parse_identity(query: str) -> Tuple[str, str, str]:
    email = _extract_email(query)

    fullname = ""
    affiliation = ""

    m = re.search(r"user\s+full\s+name\s*[:=]\s*([^;,\n]+)", query, flags=re.I)
    if m:
        fullname = _clean_space(m.group(1))

    m = re.search(r"name\s*[:=]\s*([^;,\n]+)", query, flags=re.I)
    if not fullname and m:
        fullname = _clean_space(m.group(1))

    m = re.search(r"affiliation\s*[:=]\s*([^;,\n]+)", query, flags=re.I)
    if m:
        affiliation = _clean_space(m.group(1))

    if (not fullname or not affiliation) and "use " in _norm(query):
        m = re.search(r"use\s+(.+)", query, flags=re.I)
        if m:
            tail = m.group(1)
            tail = re.sub(r"\bdry[-\s]?run\b.*", "", tail, flags=re.I).strip(" .;")
            parts = [p.strip(" .;") for p in tail.split(",") if p.strip()]
            if len(parts) >= 1 and not fullname:
                fullname = parts[0]
            if len(parts) >= 3 and not affiliation:
                affiliation = parts[2]

    if not fullname:
        fullname = "Unknown User"
    if not email:
        email = "unknown@example.com"
    if not affiliation:
        affiliation = "Unknown"

    return fullname, email, affiliation


def _valid_citation(c: str) -> bool:
    if not isinstance(c, str):
        return False

    c = c.strip()
    if not c:
        return False

    bad = ["no citations found", "no group citation created", "error", "illegal url"]
    if any(x in c.lower() for x in bad):
        return False

    return (
        c.startswith("https://w3id.org/cedar?")
        or c.startswith("experiments/")
        or c.startswith("experiments5/")
    )


def _extract_inst(inst) -> Tuple[Optional[int], Optional[str]]:
    code = getattr(inst, "code", None)
    name = getattr(inst, "name", None)

    if code is not None and name is not None:
        try:
            return int(code), str(name)
        except Exception:
            pass

    try:
        return int(inst[0]), str(inst[1])
    except Exception:
        return None, None


def _tokens(s: str) -> set:
    return set(re.findall(r"[a-z0-9]+", (s or "").lower()))


def _resolve_instruments(md: MadrigalData, instrument_raw: str) -> Tuple[List[int], List[str]]:
    raw = _clean_space(instrument_raw)

    if not raw:
        raise ValueError("Missing instrument. Example: instrument 30 or Millstone Hill IS Radar.")

    ids = _extract_explicit_instrument_ids(raw)
    if ids:
        return ids, [f"explicit numeric instrument id {x}" for x in ids]

    if re.fullmatch(r"\d+(?:\s*,\s*\d+)*", raw):
        vals = [int(x.strip()) for x in raw.split(",")]
        return vals, [f"numeric instrument id {x}" for x in vals]

    query_tokens = _tokens(raw)
    inst_list = md.getAllInstruments()

    candidates = []

    for inst in inst_list:
        inst_id, name = _extract_inst(inst)
        if inst_id is None or not name:
            continue

        name_l = name.lower()
        name_tokens = _tokens(name)

        score = 0

        if raw.lower() == name_l:
            score += 5000

        if raw.lower() in name_l:
            score += 1200

        overlap = query_tokens.intersection(name_tokens)
        score += 120 * len(overlap)

        if "millstone" in query_tokens and "hill" in query_tokens and "millstone hill" in name_l:
            score += 800

        if "is" in query_tokens and "radar" in query_tokens and "is radar" in name_l:
            score += 1200

        if "incoherent" in query_tokens and "scatter" in query_tokens and "radar" in name_l:
            score += 1200

        if score > 0:
            candidates.append((score, inst_id, name))

    candidates.sort(reverse=True, key=lambda x: x[0])

    if not candidates:
        raise ValueError(
            f"Could not resolve instrument '{raw}'. Use a numeric instrument ID, e.g. instrument 30."
        )

    top = candidates[0]
    second = candidates[1] if len(candidates) > 1 else None

    if second and (top[0] - second[0]) < 250:
        lines = [
            f"AMBIGUOUS_INSTRUMENT: '{raw}'",
            "Top candidates:",
        ]
        for score, inst_id, name in candidates[:8]:
            lines.append(f"- score {score}: id {inst_id}, {name}")
        lines.append("Reply with the numeric instrument ID you want.")
        raise ValueError("\n".join(lines))

    return [top[1]], [f"{raw} -> {top[1]} ({top[2]}) score={top[0]}"]


