            + "\n\nJoin logic: file coverage -> UTC days -> GFZ space_weather_daily on date_utc."
        ))

    def _run_generic_availability_count(self, query: str, limit: int) -> Optional[Message]:
        metric = _availability_metric(query)
        if not metric:
            return None

        if metric == "measurements":
            return Message(text=(
                "[SQL Tool]\nNEEDS_METRIC_CLARIFICATION\n\n"
                "The local MadVI headers index does not contain individual measurement-record counts. "
                "It can reliably count either indexed files or distinct covered UTC days.\n\n"
                "Try one of these:\n"
                "- How many distinct UTC days of ISR electron density are available in August 2019?\n"
                "- How many indexed ISR electron-density files are available in August 2019?\n\n"
                f"QUERY: {query}"
            ))

        window = _extract_sql_time_window(query)
        if not window:
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\n"
                "Reason: an availability count was requested, but no supported time window was found.\n\n"
                "Supported examples:\n"
                "- in 2019\n"
                "- in August 2019\n"
                "- in 2019-08\n"
                "- from 2019-08-01 to 2019-08-31\n\n"
                f"QUERY: {query}"
            ))

        product = _detect_availability_product(query)
        product_clause, product_params = self._availability_product_clause(product, "p")
        instrument_clause, instrument_params, instrument_label = self._availability_instrument_scope(query, "f")

        # A product is optional only when the user explicitly asks for generic ISR/site data.
        if not product and not instrument_clause:
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\n"
                "Reason: I detected an availability count, but could not identify a science product, "
                "parameter mnemonic, instrument family, site, or instrument ID.\n\n"
                "Examples:\n"
                "- How many days of ISR drifts are available in 2019?\n"
                "- How many days of ISR electron density are available in August 2019?\n"
                "- How many files contain TI for instrument 30 in 2020?\n\n"
                f"QUERY: {query}"
            ))

        start = str(window["start"])
        end = str(window["end"])

        overlap_count = self._fetch_sql(
            """
            SELECT COUNT(DISTINCT file_index)
            FROM files
            WHERE start_time_utc IS NOT NULL
              AND COALESCE(end_time_utc, start_time_utc) >= ?
              AND start_time_utc < ?
            """,
            (start, end),
        )
        files_in_window = int(overlap_count[0][0] or 0) if overlap_count else 0

        if files_in_window == 0:
            earliest, latest, available_years = self._db_temporal_coverage_summary()
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\n"
                "TOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\n"
                "MODE: generic_science_product_availability_count\n"
                f"QUERY: {query}\n\n"
                f"No indexed files overlap the requested window: {window['label']}.\n\n"
                "Result: not determined from this local metadata index because the requested window "
                "falls outside its indexed file coverage.\n"
                "This is not a Madrigal-wide claim that no data exist.\n\n"
                f"Indexed local time span: {earliest} to {latest}\n"
                f"Available start years: {available_years}\n\n"
                "Try a time window inside the indexed range, or refresh the local headers index."
            ))

        join_parameters = bool(product_clause)
        cte = """
            WITH RECURSIVE
            bounds AS (
                SELECT ? AS window_start, ? AS window_end
            ),
            matching_files AS (
                SELECT DISTINCT
                    f.file_index,
                    f.instrument,
                    f.instrument_code_s,
                    DATE(
                        CASE
                            WHEN f.start_time_utc < b.window_start THEN b.window_start
                            ELSE f.start_time_utc
                        END
                    ) AS start_day,
                    DATE(
                        CASE
                            WHEN COALESCE(f.end_time_utc, f.start_time_utc) >= b.window_end
                                THEN strftime('%Y-%m-%dT%H:%M:%S+00:00', b.window_end, '-1 second')
                            ELSE COALESCE(f.end_time_utc, f.start_time_utc)
                        END
                    ) AS end_day,
                    CASE
                        WHEN f.start_time_utc < b.window_start THEN b.window_start
                        ELSE f.start_time_utc
                    END AS clipped_start_time_utc,
                    CASE
                        WHEN COALESCE(f.end_time_utc, f.start_time_utc) >= b.window_end
                            THEN strftime('%Y-%m-%dT%H:%M:%S+00:00', b.window_end, '-1 second')
                        ELSE COALESCE(f.end_time_utc, f.start_time_utc)
                    END AS clipped_end_time_utc
                FROM files f
                CROSS JOIN bounds b
        """
        if join_parameters:
            cte += " JOIN parameters p ON p.file_index = f.file_index "

        where = [
            "f.start_time_utc IS NOT NULL",
            "f.start_time_utc < b.window_end",
            "COALESCE(f.end_time_utc, f.start_time_utc) >= b.window_start",
        ]
        params: List[object] = [start, end]

        if product_clause:
            where.append(product_clause)
            params.extend(product_params)

        if instrument_clause:
            where.append(instrument_clause)
            params.extend(instrument_params)

        cte += " WHERE " + " AND ".join(where)
        cte += """
            ),
            recursive_days(
                file_index,
                instrument,
                instrument_code_s,
                day,
                end_day
            ) AS (
                SELECT
                    file_index,
                    instrument,
                    instrument_code_s,
                    start_day,
                    end_day
                FROM matching_files
                WHERE start_day IS NOT NULL
                  AND end_day IS NOT NULL

                UNION ALL

                SELECT
                    file_index,
                    instrument,
                    instrument_code_s,
                    DATE(day, '+1 day'),
                    end_day
                FROM recursive_days
                WHERE day < end_day
            )
        """

        summary_rows = self._fetch_sql(
            cte + """
            SELECT
                COUNT(DISTINCT mf.file_index) AS file_count,
                COUNT(DISTINCT rd.day) AS distinct_days,
                MIN(mf.clipped_start_time_utc) AS first_time_utc,
                MAX(mf.clipped_end_time_utc) AS last_time_utc
            FROM matching_files mf
            LEFT JOIN recursive_days rd ON rd.file_index = mf.file_index
            """,
            tuple(params),
        )

        grouped_rows = self._fetch_sql(
            cte + """
            SELECT
                mf.instrument_code_s,
                mf.instrument,
                COUNT(DISTINCT rd.day) AS distinct_days,
                MIN(mf.clipped_start_time_utc) AS first_time_utc,
                MAX(mf.clipped_end_time_utc) AS last_time_utc,
                COUNT(DISTINCT mf.file_index) AS file_count
            FROM matching_files mf
            LEFT JOIN recursive_days rd ON rd.file_index = mf.file_index
            GROUP BY mf.instrument_code_s, mf.instrument
            ORDER BY distinct_days DESC, file_count DESC
            LIMIT ?
            """,
            tuple(params) + (limit,),
        )

        file_count = int(summary_rows[0][0] or 0) if summary_rows else 0
        distinct_days = int(summary_rows[0][1] or 0) if summary_rows else 0
        first_time = summary_rows[0][2] if summary_rows else None
        last_time = summary_rows[0][3] if summary_rows else None

        product_label = str(product["label"]) if product else "all indexed data"
        product_codes = ", ".join(str(x) for x in product.get("codes", [])) if product else "not restricted"

        if file_count == 0:
            closest = self._closest_availability_windows(
                product=product,
                instrument_clause=instrument_clause,
                instrument_params=instrument_params,
                limit=min(limit, 8),
            )
            closest_txt = self._format_rows(
                closest,
                [
                    "instrument_code_s",
                    "instrument",
                    "first_time_utc",
                    "last_time_utc",
                    "file_count",
                ],
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\n"
                "TOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\n"
                "MODE: generic_science_product_availability_count\n"
                f"QUERY: {query}\n\n"
                f"Local-index result for {window['label']}: 0 matching indexed files and 0 distinct UTC days.\n\n"
                f"Science product: {product_label}\n"
                f"Matched parameter mnemonics/aliases: {product_codes}\n"
                f"Instrument scope: {instrument_label}\n\n"
                "Closest indexed availability for the same product/scope:\n"
                f"{closest_txt}\n\n"
                "Caveat: zero here applies only to the local MadVI headers index. "
                "It is not a Madrigal-wide absence claim."
            ))

        lead = (
            f"Total distinct UTC days with {product_label} availability in {window['label']}: {distinct_days}"
            if metric == "days"
            else f"Total indexed files with {product_label} availability in {window['label']}: {file_count}"
        )

        grouped_txt = self._format_rows(
            grouped_rows,
            [
                "instrument_code_s",
                "instrument",
                "distinct_days",
                "first_time_utc",
                "last_time_utc",
                "file_count",
            ],
        )

        return Message(text=(
            "[SQL Tool]\n[SQL Retrieval]\n"
            "TOOL_NAME: madvi_router_executor_v4\n"
            "INTERNAL_ROUTE: HEADERS_SQL\n"
            "MODE: generic_science_product_availability_count\n"
            f"QUERY: {query}\n\n"
            f"{lead}\n"
            f"Total matching indexed files: {file_count}\n"
            f"Total distinct covered UTC days: {distinct_days}\n"
            f"First matching time inside requested window: {first_time}\n"
            f"Last matching time inside requested window: {last_time}\n\n"
            f"Science product: {product_label}\n"
            f"Matched parameter mnemonics/aliases: {product_codes}\n"
            f"Instrument scope: {instrument_label}\n"
            f"Recognized time window: {window['label']} "
            f"(inclusive start, exclusive end internally)\n\n"
            f"Grouped by instrument:\n{grouped_txt}\n\n"
            "Matching logic:\n"
            "- files were joined to parameters by file_index when a science product was requested\n"
            "- file intervals were matched by overlap with the exact requested time window\n"
            "- covered UTC days were clipped to the requested window and expanded day-by-day\n"
            "- ISR-family matching includes Millstone Hill IS Radar and its UHF steerable/zenith antenna records\n\n"
