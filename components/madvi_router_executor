def _to_text(x) -> str:
    if isinstance(x, Message):
        return x.text or ""
    return str(x or "")


def _secret_to_text(x) -> str:
    if hasattr(x, "get_secret_value"):
        return x.get_secret_value()
    return _to_text(x)


def _clean_space(text: str) -> str:
    return re.sub(r"\s+", " ", str(text or "").strip())


def _norm(text: str) -> str:
    return _clean_space(text).lower()


def _contains_any(q: str, terms: List[str]) -> bool:
    return any(t in q for t in terms)


def _extract_limit(query: str, default_limit: int = 15) -> int:
    m = re.search(r"\btop\s+(\d+)\b", query.lower())
    if m:
        try:
            return max(1, min(500, int(m.group(1))))
        except Exception:
            pass
    return default_limit


def _extract_year(query: str) -> Optional[str]:
    m = re.search(r"\b(20\d{2}|19\d{2})\b", query or "")
    return m.group(1) if m else None




MONTH_NAME_TO_NUMBER: Dict[str, int] = {
    "january": 1, "jan": 1,
    "february": 2, "feb": 2,
    "march": 3, "mar": 3,
    "april": 4, "apr": 4,
    "may": 5,
    "june": 6, "jun": 6,
    "july": 7, "jul": 7,
    "august": 8, "aug": 8,
