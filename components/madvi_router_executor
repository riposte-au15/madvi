                f"Space-weather filter: {self._space_weather_filter_text(conditions)}\n{sw_coverage_note}\n\n"
                + self._format_rows(rows, ["days", "mean", "minimum", "maximum"])
            ))

        summary = self._fetch_sql(
            cte + f"""
            SELECT COUNT(*) AS days,
                   MIN(sw.kp_max), MAX(sw.kp_max), AVG(sw.kp_max),
                   MIN(sw.ap_daily), MAX(sw.ap_daily), AVG(sw.ap_daily),
                   MIN(sw.f107_obs), MAX(sw.f107_obs), AVG(sw.f107_obs)
            FROM daily_matches dm
            JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
            {joined_where_sql}
            """,
            tuple(params) + tuple(sw_params),
        )
        sample = self._fetch_sql(
            cte + f"""
            SELECT dm.date_utc, dm.file_count, sw.kp_max, sw.ap_daily,
                   sw.f107_obs, sw.sunspot_number, sw.definitive_flag
            FROM daily_matches dm
            JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
            {joined_where_sql}
            ORDER BY dm.date_utc
            LIMIT ?
            """,
            tuple(params) + tuple(sw_params) + (limit,),
        )
        return Message(text=(
            "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
            "INTERNAL_ROUTE: HEADERS_SQL\nMODE: madrigal_space_weather_summary\n"
