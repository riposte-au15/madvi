    def _year_file_count(self, year: str) -> int:
        rows = self._fetch_sql("SELECT COUNT(*) FROM files WHERE SUBSTR(start_time_utc, 1, 4) = ?", (year,))
        return rows[0][0] if rows and rows[0] else 0

    def _db_temporal_coverage_summary(self) -> Tuple[str, str, str]:
        """
        Returns (earliest_start, latest_start, available_years_text) for user-facing SQL messages.
        Never exposes local filesystem paths.
        """
        try:
            summary = self._fetch_sql(
                """
                SELECT MIN(start_time_utc), MAX(start_time_utc)
                FROM files
                WHERE start_time_utc IS NOT NULL
                """
            )
            years = self._fetch_sql(
                """
                SELECT SUBSTR(start_time_utc, 1, 4) AS year, COUNT(DISTINCT file_index) AS file_count
                FROM files
                WHERE start_time_utc IS NOT NULL
                GROUP BY SUBSTR(start_time_utc, 1, 4)
                ORDER BY year
                """
            )
            earliest = summary[0][0] if summary and summary[0] and summary[0][0] else "unknown"
            latest = summary[0][1] if summary and summary[0] and summary[0][1] else "unknown"
            if years:
                year_text = ", ".join(f"{y} ({c} files)" for y, c in years)
            else:
                year_text = "none"
            return earliest, latest, year_text
        except Exception:
            return "unknown", "unknown", "unknown"


    def _run_parameter_definition_lookup(self, query: str) -> Message:
        mnemonics = self._extract_mnemonics(query)
        if not mnemonics:
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\nReason: Parameter definition lookup was requested, but no supported mnemonics were detected.\n\n"
                "Example: exact parameter definitions and units for gdalt, ti, te, ne\n\n"
                f"QUERY: {query}"
            ))

        if not self._table_exists("parameters"):
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\nReason: The SQLite database does not contain the expected parameters table.\n\n"
                f"Requested mnemonics: {', '.join(mnemonics)}\nQUERY: {query}"
            ))

        placeholders = ",".join(["?"] * len(mnemonics))

        rows = self._fetch_sql(
            f"""
            SELECT
                UPPER(mnemonic) AS mnemonic,
                description,
                COALESCE(
                    GROUP_CONCAT(DISTINCT CASE WHEN units IS NOT NULL AND TRIM(units) != '' THEN units END),
                    'None'
                ) AS units,
                GROUP_CONCAT(DISTINCT section) AS sections,
                COUNT(DISTINCT file_index) AS file_count
            FROM parameters
            WHERE UPPER(mnemonic) IN ({placeholders})
            GROUP BY UPPER(mnemonic), description
            ORDER BY UPPER(mnemonic), description
            """,
            tuple(mnemonics),
        )

        found = {str(r[0]).upper() for r in rows}
        missing = [m for m in mnemonics if m.upper() not in found]

        txt = self._format_rows(rows, ["mnemonic", "description", "units", "sections", "file_count"])

        extra = ""
        if missing:
            extra = (
                "\n\nMissing requested mnemonics in this local headers DB: " + ", ".join(missing) +
                "\nNote: this means the mnemonic was not found in the indexed file headers, not necessarily that Madrigal never defines it globally."
            )

        return Message(text=(
            "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\n"
            "MODE: parameter_definition_lookup\nTABLE: parameters\n"
            f"QUERY: {query}\n\n{txt}{extra}\n\n"
            "Caveat: parameter code is not present in this local parameters table; file_count indicates how many indexed files contained the mnemonic."
        ))

    def _run_sql(self, query: str) -> Message:
        q = _norm(query)
        limit = _extract_limit(query, self.SQL_DEFAULT_LIMIT)
        year = _extract_year(query)

        # Space-weather handlers run before legacy parameter-definition logic
        # because Kp may also appear as a Madrigal header mnemonic.
        combined_sw = self._run_combined_space_weather_query(query, limit)
        if combined_sw is not None:
            return combined_sw

        pure_sw = self._run_space_weather_query(query, limit)
        if pure_sw is not None:
            return pure_sw

        if (
            "parameter definition" in q or "parameter definitions" in q
            or "definitions and units" in q or "definition and units" in q
            or "parameter units" in q or "units for" in q or "unit for" in q
            or "parmcodes" in q or "parmcode" in q or "mnemonic" in q or "mnemonics" in q
        ):
            return self._run_parameter_definition_lookup(query)

        if not self._table_exists("files") or not self._table_exists("parameters"):
            tables = self._fetch_sql("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\n"
                "Reason: the local metadata index is not initialized with the expected tables: files and parameters.\n\n"
                f"Available tables: {', '.join(t[0] for t in tables) if tables else 'none'}\n"
                "Deployment note: ask the maintainer to verify that the MadVI headers SQLite index is mounted and populated.\n"
                f"QUERY: {query}"
            ))
        # Generic science-product availability counting.
        # This must run before the generic metadata-index coverage branch.
        availability_result = self._run_generic_availability_count(query, limit)
        if availability_result is not None:
            return availability_result

        # SQL metadata index temporal coverage / latest timestamp
        if (
            "start_time_utc" in q
            or "end_time_utc" in q
            or "latest start" in q
            or "earliest start" in q
            or "latest file" in q
            or "earliest file" in q
            or "sql metadata index" in q
            or "metadata index" in q
            or "database coverage" in q
            or "db coverage" in q
            or "indexed range" in q
            or "date range of the index" in q
        ):
            summary_rows = self._fetch_sql(
                """
                SELECT
                    MIN(start_time_utc) AS earliest_start_time_utc,
                    MAX(start_time_utc) AS latest_start_time_utc,
                    MIN(end_time_utc) AS earliest_end_time_utc,
                    MAX(end_time_utc) AS latest_end_time_utc,
                    COUNT(DISTINCT file_index) AS file_count
                FROM files
                """
            )

            year_rows = self._fetch_sql(
                """
                SELECT
                    SUBSTR(start_time_utc, 1, 4) AS year,
                    COUNT(DISTINCT file_index) AS file_count,
                    MIN(start_time_utc) AS first_start_time_utc,
                    MAX(end_time_utc) AS last_end_time_utc
                FROM files
                WHERE start_time_utc IS NOT NULL
                GROUP BY SUBSTR(start_time_utc, 1, 4)
                ORDER BY year
                """
            )

            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\n"
                "TOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\n"
                "MODE: sql_metadata_index_temporal_coverage\n"
                f"QUERY: {query}\n\n"
                "Overall index coverage:\n"
                + self._format_rows(
                    summary_rows,
                    [
                        "earliest_start_time_utc",
                        "latest_start_time_utc",
                        "earliest_end_time_utc",
                        "latest_end_time_utc",
                        "file_count",
                    ],
                )
                + "\n\nCoverage by start year:\n"
                + self._format_rows(
                    year_rows,
                    ["year", "file_count", "first_start_time_utc", "last_end_time_utc"],
                )
                + "\n\nCaveat: this describes only the local MadVI headers SQLite database, not all Madrigal holdings."
            ))

        # Diagnostics / broad inventory helpers
        if year and ("show" in q and "files" in q):
            rows = self._fetch_sql(
                """
                SELECT file_index, instrument_code_s, instrument, start_time_utc, end_time_utc, n_data_parameters
                FROM files
                WHERE SUBSTR(start_time_utc, 1, 4) = ?
                ORDER BY start_time_utc
                LIMIT ?
                """,
                (year, limit),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: show_files_by_year\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["file_index", "instrument_code_s", "instrument", "start_time_utc", "end_time_utc", "n_data_parameters"])
            ))

        if year and ("instruments exist" in q or "instruments in" in q or "which instruments exist" in q or "what instruments exist" in q):
            rows = self._fetch_sql(
                """
                SELECT instrument_code_s, instrument, COUNT(DISTINCT file_index) AS file_count,
                       MIN(start_time_utc) AS first_time_utc, MAX(end_time_utc) AS last_time_utc
                FROM files
                WHERE SUBSTR(start_time_utc, 1, 4) = ?
                GROUP BY instrument_code_s, instrument
                ORDER BY file_count DESC
                LIMIT ?
                """,
                (year, limit),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: instruments_by_year\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["instrument_code_s", "instrument", "file_count", "first_time_utc", "last_time_utc"])
            ))

        if year and ("parameters exist" in q or "parameters in" in q or "which parameters exist" in q or "what parameters exist" in q):
            rows = self._fetch_sql(
                """
                SELECT UPPER(p.mnemonic) AS mnemonic, p.description, COALESCE(GROUP_CONCAT(DISTINCT CASE WHEN p.units IS NOT NULL AND TRIM(p.units) != '' THEN p.units END), 'None') AS units,
                       COUNT(DISTINCT p.file_index) AS file_count
                FROM parameters p
                JOIN files f ON f.file_index = p.file_index
                WHERE SUBSTR(f.start_time_utc, 1, 4) = ?
                GROUP BY UPPER(p.mnemonic), p.description
                ORDER BY file_count DESC
                LIMIT ?
                """,
                (year, limit),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: parameters_by_year\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["mnemonic", "description", "units", "file_count"])
            ))


        # Which instruments contain PARAM [in YEAR]
        m = re.search(r"which instruments contain (.+?)(?:\s+in\s+(?:19|20)\d{2})?$", q)
        if m:
            param = m.group(1).strip()
            p_clause, p_params = self._param_where_clause(param, "p")
            year_clause = ""
            year_params: Tuple[str, ...] = tuple()
            if year:
                year_clause = "AND SUBSTR(f.start_time_utc, 1, 4) = ?"
                year_params = (year,)

            rows = self._fetch_sql(
                f"""
                SELECT
                    f.instrument_code_s,
                    f.instrument,
                    COUNT(DISTINCT f.file_index) AS file_count,
                    MIN(f.start_time_utc) AS first_time_utc,
                    MAX(f.end_time_utc) AS last_time_utc
                FROM files f
                JOIN parameters p ON p.file_index = f.file_index
                WHERE {p_clause}
                {year_clause}
                GROUP BY f.instrument_code_s, f.instrument
                ORDER BY file_count DESC
                LIMIT ?
                """,
                tuple(p_params) + tuple(year_params) + (limit,),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: instrument_parameter_lookup\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["instrument_code_s", "instrument", "file_count", "first_time_utc", "last_time_utc"])
            ))

        # Which files contain PARAM [in YEAR]
        m = re.search(r"which files contain (.+?)(?:\s+in\s+(?:19|20)\d{2})?$", q)
        if m:
            param = m.group(1).strip()
            p_clause, p_params = self._param_where_clause(param, "p")
            year_clause = ""
            year_params = tuple()
            if year:
                year_clause = "AND SUBSTR(f.start_time_utc, 1, 4) = ?"
                year_params = (year,)

            rows = self._fetch_sql(
                f"""
                SELECT f.file_index, f.instrument_code_s, f.instrument, f.start_time_utc, f.end_time_utc
                FROM files f
                JOIN parameters p ON p.file_index = f.file_index
                WHERE {p_clause}
                {year_clause}
                GROUP BY f.file_index, f.instrument_code_s, f.instrument, f.start_time_utc, f.end_time_utc
                ORDER BY f.start_time_utc
                LIMIT ?
                """,
                tuple(p_params) + tuple(year_params) + (limit,),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: file_parameter_lookup\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["file_index", "instrument_code_s", "instrument", "start_time_utc", "end_time_utc"])
            ))

        # Parameter coverage
        m = re.search(r"(?:parameter coverage|what parameters are available) (?:for|in)?\s*(.+)", q)
        if m:
            instrument = m.group(1).strip()
            rows = self._fetch_sql(
                """
                SELECT UPPER(p.mnemonic) AS mnemonic, p.description,
                       COALESCE(GROUP_CONCAT(DISTINCT CASE WHEN p.units IS NOT NULL AND TRIM(p.units) != '' THEN p.units END), 'None') AS units,
                       COUNT(DISTINCT p.file_index) AS file_count
                FROM parameters p
                JOIN files f ON f.file_index = p.file_index
                WHERE LOWER(f.instrument) LIKE ? OR LOWER(f.instrument_code_s) LIKE ?
                GROUP BY UPPER(p.mnemonic), p.description
                ORDER BY mnemonic
                LIMIT ?
                """,
                (f"%{instrument.lower()}%", f"%{instrument.lower()}%", limit),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: parameter_coverage\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["mnemonic", "description", "units", "file_count"])
            ))

        # Time coverage
        m = re.search(r"(?:coverage|years|time coverage).*(?:for|of)\s+(.+)", q)
        if m:
            instrument = m.group(1).strip()
            rows = self._fetch_sql(
                """
                SELECT f.instrument_code_s, f.instrument, MIN(f.start_time_utc) AS first_time_utc,
                       MAX(f.end_time_utc) AS last_time_utc, COUNT(DISTINCT f.file_index) AS file_count
                FROM files f
                WHERE LOWER(f.instrument) LIKE ? OR LOWER(f.instrument_code_s) LIKE ?
                GROUP BY f.instrument_code_s, f.instrument
                ORDER BY first_time_utc
                LIMIT ?
                """,
                (f"%{instrument.lower()}%", f"%{instrument.lower()}%", limit),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: time_coverage\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["instrument_code_s", "instrument", "first_time_utc", "last_time_utc", "file_count"])
            ))

        # File index / sample files
        if "file_index" in q or "file index" in q or "show files" in q:
            rows = self._fetch_sql(
                """
                SELECT file_index, instrument_code_s, instrument, start_time_utc, end_time_utc, n_data_parameters
                FROM files
                LIMIT ?
                """,
                (limit,),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: HEADERS_SQL\nMODE: file_index_lookup\n"
                f"QUERY: {query}\n\n" + self._format_rows(rows, ["file_index", "instrument_code_s", "instrument", "start_time_utc", "end_time_utc", "n_data_parameters"])
            ))

        return Message(text=(
            "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\nReason: Query was routed to SQL, but no supported SQL pattern matched.\n\n"
            "Supported examples:\n- Which instruments contain electron density?\n- Which instruments contain NEL in 2020?\n- Which files contain TEC?\n"
            "- What parameters are available for Millstone Hill?\n- What are the exact parameter definitions and units for gdalt, ti, te, ne?\n"
            "- For how many days is ISR electron density available in August 2019?\n- How many days of ISR drifts are available in 2019?\n- How many indexed files contain TI for instrument 30 in 2020?\n- Show file_index records.\n\n"
            f"QUERY: {query}"
        ))

    def run(self) -> Message:
        try:
            query = _to_text(self.query).strip()
            if not query:
                return Message(text="NO_RESULTS")

            route, reason = self._route(query)

            if route == "OUT_OF_SCOPE":
                return Message(text=OUT_OF_SCOPE_RESPONSE)

            if route == "MADRIGAL_CITATION":
                return self._run_citation(query)

            if route == "HEADERS_SQL":
                return self._run_sql(query)

            api_key = _secret_to_text(self.openai_api_key).strip()
            if not api_key:
                return Message(text="ERROR(madvi_router_executor_v4): Missing OpenAI API key")

            if route == "PAPERS":
                return self._run_papers(query, api_key)

            return self._run_docs(query, api_key)

        except Exception as e:
            return Message(text=f"ERROR(madvi_router_executor_v4): {type(e).__name__}: {e}")
