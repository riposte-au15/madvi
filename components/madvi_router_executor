}


def _iso_utc(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%dT%H:%M:%S+00:00")


def _strip_ordinal_suffixes(text: str) -> str:
    return re.sub(r"(\d+)(st|nd|rd|th)\b", r"\1", text or "", flags=re.I)


def _parse_flexible_date(value: str) -> Optional[datetime]:
    """
    Parse one calendar date without inventing a timezone.
    Returned datetimes are naive UTC calendar boundaries.
    """
    value = _strip_ordinal_suffixes(value or "")
    value = re.sub(r"\s+", " ", value.strip().strip(",.;"))

    if not value:
        return None

    formats = [
        "%Y-%m-%d",
        "%Y/%m/%d",
        "%m/%d/%Y",
        "%m-%d-%Y",
        "%B %d %Y",
        "%b %d %Y",
        "%B %d, %Y",
        "%b %d, %Y",
    ]

    for fmt in formats:
        try:
            return datetime.strptime(value, fmt)
        except ValueError:
            continue

    return None


def _extract_sql_time_window(query: str) -> Optional[Dict[str, str]]:
    """
    Convert a user time expression into an inclusive-start/exclusive-end UTC window.

    Supported examples:
      - 2019
      - August 2019 / Aug 2019
      - 2019-08
      - 2019-08-01
      - 08/01/2019
      - from 2019-08-01 to 2019-08-31
      - between August 1 and August 31, 2019
    """
    raw = _strip_ordinal_suffixes(query or "")
    q = _norm(raw)

    # Defensive local month map.
    # Langflow may compile helper functions in an isolated namespace after a
    # custom-component edit, which can make module-level constants unavailable
    # even when they are present in the source. Keeping this mapping local
    # prevents NameError: MONTH_NAME_TO_NUMBER is not defined.
    month_name_to_number = {
        "january": 1, "jan": 1,
        "february": 2, "feb": 2,
        "march": 3, "mar": 3,
        "april": 4, "apr": 4,
        "may": 5,
        "june": 6, "jun": 6,
        "july": 7, "jul": 7,
        "august": 8, "aug": 8,
        "september": 9, "sep": 9, "sept": 9,
        "october": 10, "oct": 10,
        "november": 11, "nov": 11,
        "december": 12, "dec": 12,
    }

    # Explicit ISO or slash-form date pairs.
    date_tokens = re.findall(
        r"\b(?:19|20)\d{2}[-/]\d{1,2}[-/]\d{1,2}\b"
        r"|\b\d{1,2}/\d{1,2}/(?:19|20)\d{2}\b",
        raw,
        flags=re.I,
    )

    if len(date_tokens) >= 2:
        start_dt = _parse_flexible_date(date_tokens[0])
        end_dt = _parse_flexible_date(date_tokens[1])
        if start_dt and end_dt:
            if end_dt < start_dt:
                start_dt, end_dt = end_dt, start_dt
            end_exclusive = end_dt + timedelta(days=1)
            return {
                "start": _iso_utc(start_dt),
                "end": _iso_utc(end_exclusive),
                "label": f"{start_dt:%Y-%m-%d} through {end_dt:%Y-%m-%d}",
                "granularity": "date_range",
            }

    # Two full month-name dates, each carrying its own year.
    month_date_pattern = (
        r"\b(?:january|february|march|april|may|june|july|august|"
        r"september|october|november|december|jan|feb|mar|apr|jun|jul|"
        r"aug|sep|sept|oct|nov|dec)\s+\d{1,2}(?:,\s*|\s+)(?:19|20)\d{2}\b"
    )
    named_dates = re.findall(month_date_pattern, raw, flags=re.I)
    if len(named_dates) >= 2:
        start_dt = _parse_flexible_date(named_dates[0])
        end_dt = _parse_flexible_date(named_dates[1])
        if start_dt and end_dt:
            if end_dt < start_dt:
                start_dt, end_dt = end_dt, start_dt
            end_exclusive = end_dt + timedelta(days=1)
            return {
                "start": _iso_utc(start_dt),
                "end": _iso_utc(end_exclusive),
                "label": f"{start_dt:%Y-%m-%d} through {end_dt:%Y-%m-%d}",
                "granularity": "date_range",
            }

    # Same-month or cross-month phrase where the year appears once:
    # "between August 1 and August 31, 2019"
    m = re.search(
        r"\b(?:from|between)\s+"
        r"(january|february|march|april|may|june|july|august|september|october|november|december|"
        r"jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)\s+(\d{1,2})\s+"
        r"(?:to|through|until|and|-)\s+"
        r"(?:(january|february|march|april|may|june|july|august|september|october|november|december|"
        r"jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)\s+)?"
        r"(\d{1,2})(?:,\s*|\s+)((?:19|20)\d{2})\b",
        raw,
        flags=re.I,
    )
    if m:
        month1 = month_name_to_number[m.group(1).lower()]
        month2 = month_name_to_number[(m.group(3) or m.group(1)).lower()]
        year = int(m.group(5))
        try:
            start_dt = datetime(year, month1, int(m.group(2)))
            end_dt = datetime(year, month2, int(m.group(4)))
            if end_dt < start_dt:
                start_dt, end_dt = end_dt, start_dt
            return {
                "start": _iso_utc(start_dt),
                "end": _iso_utc(end_dt + timedelta(days=1)),
                "label": f"{start_dt:%Y-%m-%d} through {end_dt:%Y-%m-%d}",
                "granularity": "date_range",
            }
        except ValueError:
            pass

    # One exact date means one UTC calendar day.
    if len(date_tokens) == 1:
        day = _parse_flexible_date(date_tokens[0])
        if day:
            return {
                "start": _iso_utc(day),
                "end": _iso_utc(day + timedelta(days=1)),
                "label": f"{day:%Y-%m-%d}",
                "granularity": "day",
            }

    if len(named_dates) == 1:
        day = _parse_flexible_date(named_dates[0])
        if day:
            return {
                "start": _iso_utc(day),
                "end": _iso_utc(day + timedelta(days=1)),
                "label": f"{day:%Y-%m-%d}",
                "granularity": "day",
            }

    # Numeric year-month, e.g. 2019-08.
    m = re.search(r"\b((?:19|20)\d{2})[-/](0?[1-9]|1[0-2])\b", raw)
    if m:
        year = int(m.group(1))
        month = int(m.group(2))
        start_dt = datetime(year, month, 1)
        if month == 12:
            end_dt = datetime(year + 1, 1, 1)
        else:
            end_dt = datetime(year, month + 1, 1)
        return {
            "start": _iso_utc(start_dt),
            "end": _iso_utc(end_dt),
            "label": f"{calendar.month_name[month]} {year}",
            "granularity": "month",
        }

    # Month name + year, e.g. August 2019.
    m = re.search(
        r"\b(january|february|march|april|may|june|july|august|september|october|november|december|"
        r"jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)\s+(?:of\s+)?((?:19|20)\d{2})\b",
        q,
        flags=re.I,
    )
    if m:
        month = month_name_to_number[m.group(1).lower()]
        year = int(m.group(2))
        start_dt = datetime(year, month, 1)
        if month == 12:
            end_dt = datetime(year + 1, 1, 1)
        else:
            end_dt = datetime(year, month + 1, 1)
        return {
            "start": _iso_utc(start_dt),
            "end": _iso_utc(end_dt),
            "label": f"{calendar.month_name[month]} {year}",
            "granularity": "month",
        }

    # Full year fallback.
    m = re.search(r"\b((?:19|20)\d{2})\b", raw)
    if m:
        year = int(m.group(1))
        return {
            "start": _iso_utc(datetime(year, 1, 1)),
            "end": _iso_utc(datetime(year + 1, 1, 1)),
            "label": str(year),
            "granularity": "year",
        }

    return None


def _availability_metric(query: str) -> Optional[str]:
    q = _norm(query)

    if (
        "how many days" in q
        or "distinct days" in q
        or "days with" in q
        or "days of" in q
        or "days are available" in q
    ):
        return "days"

    if (
        "how many files" in q
        or "number of files" in q
        or "file count" in q
        or "count of files" in q
    ):
        return "files"

    if "how many measurements" in q or "number of measurements" in q:
        return "measurements"

    return None


def _detect_availability_product(query: str) -> Optional[Dict[str, object]]:
    """
    Resolve beginner-facing science language into deterministic header-metadata matches.
    Error/uncertainty mnemonics are deliberately not included.
    Hyphenated natural-language forms are normalized (for example electron-density).
    """
    q = _norm(query).replace("-", " ")

    if "electron density" in q or re.search(r"\bne\b", q) or re.search(r"\bnel\b", q):
        return {
            "label": "electron density",
            "codes": ["NE", "NEL"],
            "description_terms": ["electron density"],
        }

    if (
        "isr drift" in q
        or "isr drifts" in q
        or "ion drift" in q
        or "ion drifts" in q
        or "line of sight velocity" in q
        or "line-of-sight velocity" in q
        or "line of sight ion velocity" in q
        or "los velocity" in q
        or re.search(r"\bvo\b", q)
        or ("drift" in q and ("isr" in q or "radar" in q or "incoherent scatter" in q))
    ):
        return {
            "label": "ISR drift / line-of-sight ion velocity",
            "codes": ["VO"],
            "description_terms": ["line of sight ion velocity"],
        }

    if "ion temperature" in q or re.search(r"\bti\b", q):
        return {
            "label": "ion temperature",
            "codes": ["TI"],
            "description_terms": ["ion temperature"],
        }

    if "electron temperature" in q or re.search(r"\bte\b", q):
        return {
            "label": "electron temperature",
            "codes": ["TE"],
            "description_terms": ["electron temperature"],
        }

    if "neutral wind" in q or re.search(r"\bvn1\b|\bvn2\b|\bvn31\b", q):
        return {
            "label": "neutral wind",
            "codes": ["VN1", "VN2", "VN31"],
            "description_terms": ["neutral wind"],
        }

    if "total electron content" in q or re.search(r"\btec\b", q):
        return {
            "label": "total electron content",
            "codes": ["TEC"],
            "description_terms": ["total electron content"],
        }

    if "geodetic altitude" in q or re.search(r"\bgdalt\b", q):
        return {
            "label": "geodetic altitude",
            "codes": ["GDALT"],
            "description_terms": ["geodetic altitude"],
        }

    explicit_codes = []
    for mnemonic in [
        "GDALT", "TI", "TE", "TEC", "NE", "NEL", "POPL", "DPOP",
        "VO", "VI", "VN1", "VN2", "VN31", "GDLAT", "GDLON",
        "GLON", "RANGE", "AZM", "ELM", "KP", "DST",
    ]:
        if re.search(rf"\b{re.escape(mnemonic.lower())}\b", q):
            explicit_codes.append(mnemonic)

    if explicit_codes:
        return {
            "label": "requested Madrigal parameter(s)",
            "codes": explicit_codes,
            "description_terms": [],
        }

    return None



def _has_space_weather_terms(query: str) -> bool:
    """Return True when a query explicitly references supported space-weather concepts."""
    q = _norm(query)
    return bool(
        re.search(r"\bkp\b", q)
        or re.search(r"\bap\b", q)
        or "f10.7" in q
        or "f107" in q
        or "solar radio flux" in q
        or "sunspot number" in q
        or re.search(r"\bsn\b", q)
        or "space weather" in q
        or "geomagnetic activity" in q
        or "geomagnetic conditions" in q
        or "geomagnetically disturbed" in q
        or "geomagnetic storm" in q
        or "storm conditions" in q
    )


def _space_weather_metric(query: str) -> Optional[Dict[str, str]]:
    """Map user language to an allow-listed daily space-weather column."""
    q = _norm(query)

    if (
        "f10.7adj" in q or "f107adj" in q or "f10.7 adj" in q
        or "f107 adj" in q or "adjusted f10.7" in q or "adjusted f107" in q
    ):
        return {"column": "f107_adj", "label": "F10.7 adjusted", "units": "sfu"}

    if "f10.7" in q or "f107" in q or "solar radio flux" in q:
        return {"column": "f107_obs", "label": "F10.7 observed", "units": "sfu"}

    if "sunspot number" in q or re.search(r"\bsn\b", q):
        return {"column": "sunspot_number", "label": "sunspot number", "units": "count"}

    if re.search(r"\bap\b", q):
        if (
            "max ap" in q or "maximum ap" in q or "ap max" in q
            or "3-hour ap" in q or "3 hour ap" in q
            or "three-hour ap" in q or "three hour ap" in q
        ):
            return {"column": "ap_max", "label": "maximum 3-hour ap", "units": "index"}
        return {"column": "ap_daily", "label": "daily Ap", "units": "index"}

    if re.search(r"\bkp\b", q):
        if "mean kp" in q or "average kp" in q or "avg kp" in q:
            return {"column": "kp_mean", "label": "mean daily Kp", "units": "index"}
        return {"column": "kp_max", "label": "maximum 3-hour Kp within the UTC day", "units": "index"}

    return None


def _extract_space_weather_conditions(query: str) -> List[Dict[str, object]]:
    """Extract explicit filters such as Kp >= 5, daily Ap > 30, F10.7obs > 150."""
    raw = str(query or "")
    conditions: List[Dict[str, object]] = []

    specs = [
        ("f107_adj", "F10.7 adjusted", r"(?:f10\.7\s*(?:adj|adjusted)|f107\s*(?:adj|adjusted)|adjusted\s+f10\.7|adjusted\s+f107)"),
        ("f107_obs", "F10.7 observed", r"(?:f10\.7\s*(?:obs|observed)?|f107\s*(?:obs|observed)?|solar\s+radio\s+flux)"),
        ("sunspot_number", "sunspot number", r"(?:sunspot\s+number|\bSN\b)"),
        ("kp_max", "maximum daily Kp", r"\bKp\b"),
        ("ap_daily", "daily Ap", r"\bAp\b|\bap\b"),
    ]

    op_words = (
        r">=|<=|==|=|>|<|"
        r"at\s+least|at\s+most|"
        r"greater\s+than\s+or\s+equal\s+to|less\s+than\s+or\s+equal\s+to|"
        r"greater\s+than|less\s+than|above|over|below|under|equals?|equal\s+to"
    )

    def normalize_op(op_text: str) -> str:
        o = _norm(op_text)
        if o in [">=", "at least", "greater than or equal to"]:
            return ">="
        if o in ["<=", "at most", "less than or equal to"]:
            return "<="
        if o in [">", "above", "over", "greater than"]:
            return ">"
        if o in ["<", "below", "under", "less than"]:
            return "<"
        return "="

    seen = set()
    for column, label, alias_pattern in specs:
        pattern = (
            rf"({alias_pattern})"
            rf"(?:\s+(?:index|value|max|maximum|daily|observed|adjusted|was|is|of))*"
            rf"\s*({op_words})\s*(-?\d+(?:\.\d+)?)"
        )
        m = re.search(pattern, raw, flags=re.I)
        if not m:
            continue
        op = normalize_op(m.group(2))
        value = float(m.group(3))
        key = (column, op, value)
        if key in seen:
            continue
        seen.add(key)
        conditions.append({"column": column, "label": label, "operator": op, "value": value})

    return conditions


def _space_weather_condition_sql(
    conditions: List[Dict[str, object]],
    alias: str = "sw",
) -> Tuple[str, Tuple[object, ...]]:
    """Build a SQL predicate using only allow-listed columns/operators."""
    allowed_columns = {
        "kp_max", "kp_mean", "ap_daily", "ap_max",
        "f107_obs", "f107_adj", "sunspot_number",
    }
    allowed_ops = {">", ">=", "<", "<=", "="}
    clauses = []
    params: List[object] = []

    for item in conditions:
        column = str(item.get("column", ""))
        op = str(item.get("operator", ""))
        if column not in allowed_columns or op not in allowed_ops:
            continue
        clauses.append(f"{alias}.{column} {op} ?")
        params.append(item.get("value"))

    return " AND ".join(clauses), tuple(params)


def _space_weather_intent(query: str) -> str:
    q = _norm(query)
    if re.search(r"\b(?:how many|count|number of)\b", q):
        return "count"

    # Explicit day/date listing language should stay a list even if the user
    # refers to the day's maximum Kp value.
    if (
        "which days" in q or "what days" in q or "list days" in q
        or "show days" in q or "which dates" in q or "what dates" in q
        or "list dates" in q or "show dates" in q
    ):
        return "list_days"

    # Aggregate-statistic questions get priority over incidental words such as
    # "days" later in the sentence (e.g. "What was the maximum Kp on ISR days?").
    if re.search(r"\b(?:what|which)\b.{0,30}\b(?:maximum|max|highest|peak)\b", q):
        return "max"
    if re.search(r"\b(?:what|which)\b.{0,30}\b(?:minimum|min|lowest)\b", q):
        return "min"
    if re.search(r"\b(?:what|which)\b.{0,30}\b(?:average|mean|avg)\b", q):
        return "mean"

    if re.search(r"\b(?:which|what|show|list)\b.*\bfiles?\b", q):
        return "list_files"
    if bool(re.search(r"\b(?:which|what|list|show)\b.*\b(?:days|dates)\b", q)):
        return "list_days"

    if re.search(r"\b(?:maximum|max|highest|peak)\b", q):
        return "max"
    if re.search(r"\b(?:minimum|min|lowest)\b", q):
        return "min"
    if re.search(r"\b(?:average|mean|avg)\b", q):
        return "mean"
    if "latest" in q or "most recent" in q:
        return "latest"
    return "summary"

def _needs_space_weather_threshold_clarification(query: str) -> bool:
    q = _norm(query)
    qualitative = any(x in q for x in [
        "high geomagnetic activity",
        "strong geomagnetic activity",
        "low geomagnetic activity",
        "geomagnetically disturbed",
        "disturbed geomagnetic",
        "geomagnetic storm",
        "storm conditions",
        "quiet geomagnetic",
        "quiet conditions",
    ])
    return qualitative and not _extract_space_weather_conditions(query)

