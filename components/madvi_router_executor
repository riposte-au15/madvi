            "persistent link",
            "zenodo replacement",
            "difference between",
            "when should",
            "how does",
            "how do i use",
            "how to use",
        ]

        if _contains_any(q, docs_terms):
            return "DOCS", "Documentation/API/script/workflow query."

        # ------------------------------------------------------------
        # 5. Scientific subject questions default to the paper corpus when
        # no exact metadata operation was requested.
        # ------------------------------------------------------------
        science_terms = [
            "geomagnetic",
            "storm",
            "storms",
            "storm-time",
            "storm time",
            "substorm",
            "saps",
            "said",
            "tec",
