    def _route(self, query: str) -> Tuple[str, str]:
        """
        Priority-safe deterministic router.

        Routing order is intentional:
        0. Universal Madrigal-only scope gate
        1. Madrigal citation actions
        2. Explicit literature/paper requests
        3. Exact SQL metadata/count/coverage requests
        4. Documentation/API/script questions
        5. Scientific-topic fallback to papers
        6. Documentation fallback for in-scope Madrigal queries

        A year, instrument name, Madrigal, ISR, or the word "data" alone never
        forces SQL. SQL requires an explicit metadata operation such as count,
        availability, coverage, inventory, parameter definition, or file lookup.
        """
        q = _norm(query)

        # ------------------------------------------------------------
        # 0. Universal Madrigal-only domain boundary
        # ------------------------------------------------------------
        if not _is_madrigal_scope_query(query):
            return "OUT_OF_SCOPE", "Query is outside the Madrigal/geospace domain supported by MadVI."

        # ------------------------------------------------------------
        # 1. Explicit state-changing Madrigal citation action
        # ------------------------------------------------------------
        if _is_citation_action_query(query):
            return "MADRIGAL_CITATION", "Explicit Madrigal citation creation/dry-run action."

        # ------------------------------------------------------------
        # 2. Literature intent has priority over every read-only route.
        # This prevents publication years such as "after 2021" from being
        # mistaken for metadata time windows.
        # ------------------------------------------------------------
        paper_noun_pattern = (
            r"\b(?:paper|papers|study|studies|article|articles|publication|publications|"
            r"literature|journal article|journal papers?|research paper|scientific paper|"
            r"scientific study|authors?)\b"
        )
        paper_action_pattern = (
            r"\b(?:find|search|locate|identify|recommend|retrieve|show|list|provide|"
            r"give|look for|look up|cite|summarize|compare)\b"
        )

        has_paper_noun = bool(re.search(paper_noun_pattern, q))
        has_paper_action = bool(re.search(paper_action_pattern, q))
        has_publication_filter = bool(re.search(
            r"\b(?:published|publication year|after|before|since|newer than|older than|"
            r"recent|latest|earliest|between)\b",
            q,
        ))
        has_paper_question = bool(re.search(
            r"\b(?:which|what|whose|is there|are there|do you know of|can you find|"
            r"could you find|find me)\b.*" + paper_noun_pattern,
            q,
        ))
        has_paper_usage_language = bool(re.search(
            paper_noun_pattern + r".*\b(?:used|using|uses|studied|studying|reported|found|"
            r"analyzed|analysed|included|based on|with)\b",
            q,
        ))

        explicit_literature_terms = [
            "literature review",
            "scientific literature",
            "research literature",
            "papers that used",
            "paper that used",
            "studies that used",
            "study that used",
            "research that used",
            "find a paper",
            "find me a paper",
            "find papers",
            "search papers",
            "search for a paper",
            "which papers",
            "what papers",
            "which studies",
            "what studies",
            "paper published",
            "papers published",
            "study published",
            "article published",
        ]

        if (
            _contains_any(q, explicit_literature_terms)
            or has_paper_question
            or (has_paper_noun and has_paper_action)
            or (has_paper_noun and has_publication_filter)
            or has_paper_usage_language
        ):
            return "PAPERS", "Explicit scientific literature/publication request."

        # ------------------------------------------------------------
        # 3. SQL metadata route. SQL must be requested through an actual
        # metadata operation, not merely by mentioning a year or data.
        # ------------------------------------------------------------
        sql_strong_terms = [
            "which instruments contain",
            "what instruments contain",
            "which instruments have",
            "what instruments have",
            "which files contain",
            "what files contain",
            "which datasets contain",
            "what datasets contain",
            "what parameters are available",
            "which parameters are available",
            "parameters available for",
            "parameter coverage",
            "instrument coverage",
            "file coverage",
            "time coverage",
            "metadata inventory",
            "file_index",
            "file index",
            "exact coverage",
            "exact availability",
            "exact madrigal parameter definitions",
            "parameter definitions",
            "parameter definition",
            "definitions and units",
            "definition and units",
            "parameter units",
            "units for",
            "unit for",
            "mnemonic",
            "mnemonics",
            "parmcode",
            "parmcodes",
            "parmcodes.txt",
            "show 10 files",
            "show files",
            "show file records",
            "which instruments exist",
            "what instruments exist",
            "which parameters exist",
            "what parameters exist",
            "start_time_utc",
            "end_time_utc",
            "latest start_time_utc",
            "earliest start_time_utc",
            "latest start",
            "earliest start",
            "latest file",
            "earliest file",
            "sql metadata index",
            "metadata index",
            "max start_time_utc",
            "min start_time_utc",
            "database coverage",
            "db coverage",
            "indexed range",
            "date range of the index",
        ]

        if _contains_any(q, sql_strong_terms):
            return "HEADERS_SQL", "Explicit metadata inventory/definition/file lookup request."

        # Structured space-weather requests go to SQL after literature intent has
        # already had priority above.
        if _has_space_weather_terms(query):
            sw_window = _extract_sql_time_window(query)
            sw_conditions = _extract_space_weather_conditions(query)
            sw_intent = _space_weather_intent(query)
            if sw_conditions or sw_window or sw_intent in {"count", "list_days", "list_files", "max", "min", "mean", "latest"}:
                return "HEADERS_SQL", "Structured GFZ space-weather or combined Madrigal/space-weather query."

        metric = _availability_metric(query)
        window = _extract_sql_time_window(query)
        product = _detect_availability_product(query)

        has_instrument_or_site_scope = bool(
            _extract_explicit_instrument_ids(query)
            or re.search(r"\b(?:isr|incoherent scatter|is radar|radar|instrument|kinst)\b", q)
            or _contains_any(q, [
                "millstone hill",
                "jicamarca",
                "arecibo",
                "poker flat",
                "sondrestrom",
                "fabry-perot",
                "fabry perot",
                "fpi",
            ])
        )
        has_data_scope = bool(
            product
            or has_instrument_or_site_scope
            or re.search(r"\b(?:data|files?|datasets?|experiments?|measurements?|records?|parameters?)\b", q)
        )
        has_availability_language = bool(re.search(
            r"\b(?:available|availability|coverage|covered|exist|exists|present|holdings?)\b",
            q,
        ))
        has_count_language = bool(re.search(
            r"\b(?:how many|how much|count|number of|distinct days?|file count)\b",
            q,
        ))

        # Generic day/file/measurement counter handled by the SQL executor.
        if metric and window and has_data_scope:
            return "HEADERS_SQL", "Explicit time-bounded metadata count request."

        # Natural availability questions that do not literally say "how many".
        if window and has_data_scope and (has_availability_language or has_count_language):
            return "HEADERS_SQL", "Explicit time-bounded metadata availability request."

        # Non-time-bounded but still unambiguous metadata operations.
        sql_operation_patterns = [
            r"\b(?:list|show|return)\b.*\b(?:files?|instruments?|parameters?|datasets?|records?)\b",
            r"\b(?:which|what)\b.*\b(?:files?|instruments?|parameters?|datasets?)\b.*\b(?:contain|have|include|exist)\b",
            r"\b(?:count|number of|how many)\b.*\b(?:files?|instruments?|parameters?|datasets?|experiments?)\b",
            r"\b(?:first|last|earliest|latest|min|max)\b.*\b(?:time|date|file|record)\b",
        ]
        if any(re.search(pattern, q) for pattern in sql_operation_patterns):
            return "HEADERS_SQL", "Explicit metadata operation request."

        # ------------------------------------------------------------
        # 4. Documentation/API/script/workflow questions
        # ------------------------------------------------------------
        docs_terms = [
            "documentation",
            "docs",
            "api",
            "script",
            "command line",
