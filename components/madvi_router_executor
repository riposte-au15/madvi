            "mstid",
            "mstids",
            "climatology",
            "ionospheric behavior",
            "ionospheric response",
            "ionosphere",
            "sed",
            "sar arc",
            "tad",
        ]

        if _contains_any(q, science_terms):
            return "PAPERS", "Scientific topic query without an explicit metadata operation."

        # ------------------------------------------------------------
        # 6. Conservative fallback: Madrigal documentation
        # ------------------------------------------------------------
        return "DOCS", "Default documentation fallback."

    def _run_citation(self, query: str) -> Message:
        url = _normalize_url(_to_text(self.madrigal_url))
        md = MadrigalData(url)

        instrument_raw = _extract_instrument_text(query)
        start_date, end_date = _parse_dates(query)

        if not instrument_raw:
            return Message(text=("[Citation]\nMISSING_CITATION_INPUTS\n\nReason: Missing instrument.\n\nExample:\nCreate a dry-run Madrigal citation for instrument 30 from 2020-01-01 to 2020-12-31. Use Nano, mrojas98@mit.edu, MIT."))

        if not start_date or not end_date:
            return Message(text=("[Citation]\nMISSING_CITATION_INPUTS\n\nReason: Missing date range.\n\nExample date range:\nfrom 2020-01-01 to 2020-12-31"))

        fullname, email, affiliation = _parse_identity(query)
        start_dt = _parse_date(start_date)
        end_dt = _parse_date(end_date)
        inst_ids, inst_debug = _resolve_instruments(md, instrument_raw)

        raw_citations = md.getCitationListFromFilters(
            startDate=start_dt, endDate=end_dt, inst=inst_ids, kindat=None,
            seasonalStartDate=None, seasonalEndDate=None,
            includeNonDefault=bool(self.include_non_default), expName=None,
            excludeExpName=None, fileDesc=None, dateList=None,
        )

        valid_citations = [html.unescape(str(c).strip()) for c in raw_citations if _valid_citation(str(c))]

        if not valid_citations:
            return Message(text=(
                "[Citation]\nNO_VALID_CITATIONS\n\n"
                "No valid Madrigal file citations were found with the given filters.\n\n"
                f"Madrigal URL: {url}\nInstrument input: {instrument_raw}\nResolved instrument IDs: {inst_ids}\n"
                f"Date range: {start_date} to {end_date}\nInclude non-default files: {bool(self.include_non_default)}\n\n"
                "Try a wider date range, a numeric instrument ID, or enable include_non_default."
            ))

        q = _norm(query)
        real_creation_terms = [
            "real madrigal citation", "real citation", "real citation group", "create the real",
            "create real", "actually create", "permanent citation group", "create permanent",
            "not a dry run", "not dry run", "not dry-run", "dry_run false", "dry_run=false",
        ]
        dry_run_terms = ["dry run", "dry-run", "preview", "test only", "dry_run true", "dry_run=true"]

        dry_run = True
        if any(term in q for term in dry_run_terms):
            dry_run = True
        if any(term in q for term in real_creation_terms):
            dry_run = False

        preview = "\n".join(valid_citations[:10])
        package_nudge = (
            "\n\nZENODO_PACKAGE_NUDGE:\n"
            "This Madrigal citation result can be used as the Madrigal provenance layer of a full Zenodo/DOI package.\n"
            "Next step prompt:\n"
            "\"Build a DOI-ready Zenodo package from this Madrigal citation result, including the cited HDF5 file references, retrieval provenance, citation group URL if created, metadata, and a README.\"\n\n"
            "Important: Madrigal citation groups are not Zenodo DOIs by themselves. To include actual HDF5 files inside the Zenodo package, the package workflow must download or receive the cited files."
        )

        if dry_run:
            return Message(text=(
                "[Citation]\nDRY_RUN(madvi_router_executor_v4)\n\n[Madrigal Native Citation Preview]\n\n"
                f"Madrigal URL: {url}\nInstrument input: {instrument_raw}\nResolved instrument IDs: {inst_ids}\n"
                f"Date range: {start_date} to {end_date}\nUser full name: {fullname}\nUser email: {email}\n"
                f"User affiliation: {affiliation}\nValid citation count: {len(valid_citations)}\n\n"
                f"First cited file references:\n{preview}\n\n"
                "No permanent citation group was created because dry_run=True.\n\n"
                "Notes:\n- This is a Madrigal-native citation preview.\n- This is not a Zenodo DOI deposit.\n- Use a real citation request only when the user explicitly asks to create it."
                f"{package_nudge}"
            ))

        group_url = md.createCitationGroupFromList(valid_citations, fullname, email, affiliation, useLocal=bool(self.use_local))
        group_url = html.unescape(str(group_url).strip())

        if not group_url.startswith("http"):
            return Message(text=f"[Citation]\nERROR(madvi_router_executor_v4): Madrigal did not return a valid citation group URL.\n\nReturned value:\n{group_url}")

        recovered_files = md.getCitedFilesFromUrl(group_url)
        recovered_files = [html.unescape(str(f).strip()) for f in recovered_files if str(f).strip()]
        recovered_preview = "\n".join(recovered_files[:10])

        return Message(text=(
            "[Citation]\nSUCCESS(madvi_router_executor_v4)\n\n[Madrigal Native Citation Created]\n\n"
            f"Citation Group URL:\n{group_url}\n\nMadrigal URL: {url}\nInstrument input: {instrument_raw}\n"
            f"Resolved instrument IDs: {inst_ids}\nDate range: {start_date} to {end_date}\nUser full name: {fullname}\n"
            f"User email: {email}\nUser affiliation: {affiliation}\nValid citation count: {len(valid_citations)}\n"
            f"Recovered file count: {len(recovered_files)}\n\nFirst recovered/cited files:\n{recovered_preview}\n\n"
            "Notes:\n- This is a Madrigal-native persistent citation group.\n- This is not a Zenodo DOI deposit.\n- Use this as provenance for reproducible papers, notebooks, or DOI-ready packages."
            f"{package_nudge}"
        ))

    def _looks_like_docs_record(self, doc: str) -> bool:
        text = _norm(doc)
        return any(x in text for x in [
            "globaldownload", "globalisprint", "globalcitation", "madrigaldata", "madrigalweb",
            "getexperiments", "metadata", "api", "installation", "configuration", "cedar", "madrigal",
        ])

    def _run_docs(self, query: str, api_key: str) -> Message:
        emb = OpenAIEmbeddings(model="text-embedding-3-small", api_key=api_key)
        q_emb = emb.embed_query(query)

        client = chromadb.PersistentClient(path=self.DOCS_PERSIST_DIR)
        col = client.get_collection(self.DOCS_COLLECTION)

        res = col.query(query_embeddings=[q_emb], n_results=self.DOCS_CANDIDATE_K, include=["documents", "distances"])
        docs = res.get("documents", [[]])[0]
        dists = res.get("distances", [[]])[0]

        if not docs:
            return Message(text=f"[Docs]\nNO_RESULTS\n\nQUERY: {query}")

        valid = []
        for i, doc in enumerate(docs):
            if not doc:
                continue
            if not self._looks_like_docs_record(doc):
                continue
            dist = dists[i] if i < len(dists) else None
            valid.append({"doc": doc, "distance": dist, "rank": i + 1})

        if not valid:
            return Message(text=("[Docs]\nNO_VALID_DOC_RESULTS\n\nReason: Chroma returned records, but none appeared to be valid Madrigal documentation records.\n\n" f"QUERY: {query}"))

        selected = valid[: self.DOCS_RETURN_K]
        blocks = []
        for idx, item in enumerate(selected, start=1):
            distance_txt = f"{item['distance']:.4f}" if item["distance"] is not None else "unknown"
            blocks.append(f"[{idx}] Madrigal Documentation\n\nRAW_CHROMA_RANK: {item['rank']}\nVECTOR_DISTANCE: {distance_txt}\n\n{item['doc'][:self.DOCS_MAX_CHARS].strip()}")

        return Message(text=(
            "[Docs]\n[Docs Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: DOCS\n"
            f"COLLECTION: {self.DOCS_COLLECTION}\nQUERY: {query}\nCANDIDATES_RETRIEVED: {len(docs)}\n"
            f"VALID_DOC_CANDIDATES: {len(valid)}\nRETURNED_RESULTS: {len(selected)}\n\n" + "\n\n".join(blocks)
        ))

    def _looks_like_paper_record(self, doc: str) -> bool:
        text = _norm(doc)
        markers = ["q1", "q2", "q3", "q4", "main findings", "main conclusions", "what data from madrigal was used", "paper:"]
        return sum(1 for x in markers if x in text) >= 2

    def _rerank_paper(self, query: str, doc: str, base_distance: float) -> float:
        q = _norm(query)
        d = _norm(doc)
        score = 100.0 - (base_distance * 100.0)
        for kw in ["dmsp", "electron density", "geomagnetic", "storm", "storms", "tec", "saps", "isr", "climatology", "substorm", "ionosphere"]:
            if kw in q and kw in d:
                score += 4.0
        return round(score, 2)

    def _run_papers(self, query: str, api_key: str) -> Message:
        emb = OpenAIEmbeddings(model="text-embedding-3-small", api_key=api_key)
        q_emb = emb.embed_query(query)

        client = chromadb.PersistentClient(path=self.PAPERS_PERSIST_DIR)
        col = client.get_collection(self.PAPERS_COLLECTION)

        res = col.query(query_embeddings=[q_emb], n_results=self.PAPERS_CANDIDATE_K, include=["documents", "distances"])
        docs = res.get("documents", [[]])[0]
        dists = res.get("distances", [[]])[0]

        if not docs:
            return Message(text=f"[Papers]\nNO_RESULTS\n\nQUERY: {query}")

        valid = []
        for i, doc in enumerate(docs):
            if not doc:
                continue
            if not self._looks_like_paper_record(doc):
                continue
            dist = dists[i] if i < len(dists) else 1.0
            rerank = self._rerank_paper(query, doc, dist)
            valid.append({"doc": doc, "distance": dist, "rerank": rerank, "rank": i + 1})

        if not valid:
            return Message(text=("[Papers]\nNO_VALID_PAPER_RESULTS\n\nReason: Chroma returned records, but none appeared to be valid scientific-paper records.\n\n" f"QUERY: {query}"))

        valid = sorted(valid, key=lambda x: x["rerank"], reverse=True)
        selected = valid[: self.PAPERS_RETURN_K]

        blocks = []
        for idx, item in enumerate(selected, start=1):
            blocks.append(
                "[%d] madrigal_papers_table\n\nRERANK_SCORE: %.2f\nRAW_CHROMA_RANK: %d\nVECTOR_DISTANCE: %.4f\n\n%s"
                % (idx, item["rerank"], item["rank"], item["distance"], item["doc"][:self.PAPERS_MAX_CHARS].strip())
            )

        return Message(text=(
            "[Papers]\n[Papers Retrieval]\nTOOL_NAME: madvi_router_executor_v4\nINTERNAL_ROUTE: PAPERS\n"
            f"COLLECTION: {self.PAPERS_COLLECTION}\nQUERY: {query}\nCANDIDATES_RETRIEVED: {len(docs)}\n"
            f"VALID_PAPER_CANDIDATES: {len(valid)}\nRETURNED_RESULTS: {len(selected)}\n\n" + "\n\n".join(blocks)
        ))

    def _get_sql_db_path(self) -> str:
        custom = _to_text(getattr(self, "sql_db_path", "")).strip()
        return custom or self.SQL_DB_PATH

    def _get_space_weather_db_path(self) -> str:
        custom = _to_text(getattr(self, "space_weather_db_path", "")).strip()
        return custom or self.SPACE_WEATHER_DB_PATH

    def _connect_sql(self):
        """Connect to headers DB and attach space_weather.db as schema `sw` when available."""
        conn = sqlite3.connect(self._get_sql_db_path())
        sw_path = self._get_space_weather_db_path()
        if sw_path and os.path.isfile(sw_path):
            try:
                conn.execute("ATTACH DATABASE ? AS sw", (sw_path,))
            except sqlite3.OperationalError as e:
                if "already in use" not in str(e).lower():
                    conn.close()
                    raise
        return conn

    def _fetch_sql(self, sql: str, params: tuple = ()) -> List[tuple]:
        conn = self._connect_sql()
        try:
            cur = conn.cursor()
            cur.execute(sql, params)
            return cur.fetchall()
        finally:
            conn.close()

    def _table_exists(self, table_name: str, schema: str = "main") -> bool:
        safe_schema = "sw" if schema == "sw" else "main"
        try:
            rows = self._fetch_sql(
                f"SELECT name FROM {safe_schema}.sqlite_master WHERE type='table' AND LOWER(name)=LOWER(?)",
                (table_name,),
            )
            return bool(rows)
        except sqlite3.Error:
            return False

    def _space_weather_ready(self) -> bool:
        return self._table_exists("space_weather_daily", schema="sw")

    def _space_weather_missing_message(self, query: str) -> Message:
        return Message(text=(
            "[SQL Tool]\nSPACE_WEATHER_DB_UNAVAILABLE\n\n"
            "This query requires the GFZ space-weather database, but space_weather.db "
            "could not be found or does not contain the expected space_weather_daily table.\n\n"
            "Expected default path: /home/domo/Langflow311/space_weather.db\n"
            "You can override it with the Space Weather DB Path input.\n\n"
            f"QUERY: {query}"
        ))

    def _format_rows(self, rows: List[tuple], headers: List[str]) -> str:
        if not rows:
            return "NO_RESULTS"
        lines = []
        header_line = " | ".join(headers)
        lines.append(header_line)
        lines.append("-" * len(header_line))
        for row in rows:
            lines.append(" | ".join("" if x is None else str(x) for x in row))
        return "\n".join(lines)

    def _extract_mnemonics(self, query: str) -> List[str]:
        q = _norm(query)
        known = ["gdalt", "ti", "te", "tec", "ne", "nel", "popl", "dpop", "vo", "vi", "gdlat", "gdlon", "glon", "range", "azm", "elm", "kp", "dst"]
        found = []
        for mnemonic in known:
            if re.search(rf"\b{re.escape(mnemonic)}\b", q):
                found.append(mnemonic.upper())
        return found

    def _param_where_clause(self, param: str, alias: str = "p") -> Tuple[str, Tuple[str, ...]]:
        p = _norm(param)

        if p in ["electron density", "density", "ne", "nel"] or "electron density" in p:
            return (
                f"(UPPER({alias}.mnemonic) IN ('NE','NEL') OR LOWER({alias}.description) LIKE '%electron density%')",
                tuple(),
            )

        if p in ["electron temperature", "temperature electrons", "te"] or "electron temperature" in p:
            return (
                f"(UPPER({alias}.mnemonic) = 'TE' OR LOWER({alias}.description) LIKE '%electron temperature%')",
                tuple(),
            )

        if p in ["ion temperature", "ti"] or "ion temperature" in p:
            return (
                f"(UPPER({alias}.mnemonic) = 'TI' OR LOWER({alias}.description) LIKE '%ion temperature%')",
                tuple(),
            )

        token = p.strip().upper()
        like = f"%{p}%"
        return (
            f"(UPPER({alias}.mnemonic) = ? OR LOWER({alias}.mnemonic) LIKE ? OR LOWER({alias}.description) LIKE ?)",
            (token, like, like),
        )

    def _instrument_isr_clause(self, alias: str = "f") -> str:
        """
        ISR-family matching for the current MadVI headers index.

        Millstone Hill data can be indexed under the site-wide IS Radar name
        or under the UHF steerable/zenith antenna instrument records.
        """
        return (
            f"(LOWER({alias}.instrument) LIKE '%radar%' "
            f"OR LOWER({alias}.instrument) LIKE '%incoherent%' "
            f"OR LOWER({alias}.instrument) LIKE '%isr%' "
            f"OR LOWER({alias}.instrument) LIKE '%is radar%' "
            f"OR LOWER({alias}.instrument) LIKE '%uhf steerable antenna%' "
            f"OR LOWER({alias}.instrument) LIKE '%uhf zenith antenna%' "
            f"OR EXISTS ("
            f"SELECT 1 FROM file_instruments fi_isr "
            f"WHERE fi_isr.file_index = {alias}.file_index "
            f"AND fi_isr.instrument_code IN (30,31,32)"
            f"))"
        )

    def _availability_product_clause(
        self,
        product: Optional[Dict[str, object]],
        alias: str = "p",
    ) -> Tuple[str, Tuple[str, ...]]:
        if not product:
            return "", tuple()

        codes = [str(x).upper() for x in product.get("codes", []) if str(x).strip()]
        description_terms = [
            _norm(str(x))
            for x in product.get("description_terms", [])
            if str(x).strip()
        ]

        pieces = []
        params: List[str] = []

        if codes:
            placeholders = ",".join(["?"] * len(codes))
            pieces.append(f"UPPER({alias}.mnemonic) IN ({placeholders})")
            params.extend(codes)

        for term in description_terms:
            pieces.append(f"LOWER({alias}.description) LIKE ?")
            params.append(f"%{term}%")

        if not pieces:
            return "", tuple()

        return "(" + " OR ".join(pieces) + ")", tuple(params)

    def _availability_instrument_scope(
        self,
        query: str,
        alias: str = "f",
    ) -> Tuple[str, Tuple[object, ...], str]:
        q = _norm(query)
        clauses = []
        params: List[object] = []
        labels = []

        explicit_ids = _extract_explicit_instrument_ids(query)
        if explicit_ids:
            placeholders = ",".join(["?"] * len(explicit_ids))
            clauses.append(
                f"EXISTS ("
                f"SELECT 1 FROM file_instruments fi_explicit "
                f"WHERE fi_explicit.file_index = {alias}.file_index "
                f"AND fi_explicit.instrument_code IN ({placeholders})"
                f")"
            )
            params.extend(explicit_ids)
            labels.append("instrument ID " + ", ".join(str(x) for x in explicit_ids))

        isr_requested = (
            re.search(r"\bisr\b", q)
            or "incoherent scatter" in q
            or "is radar" in q
            or "radar instruments" in q
            or "radar data" in q
            or "radar measurements" in q
        )
        if isr_requested:
            clauses.append(self._instrument_isr_clause(alias))
            labels.append("ISR-family instruments")

        if "millstone hill" in q:
            clauses.append(f"LOWER({alias}.instrument) LIKE ?")
            params.append("%millstone hill%")
            labels.append("Millstone Hill")

        if "fabry-perot" in q or "fabry perot" in q or re.search(r"\bfpi\b", q):
            clauses.append(
                f"(LOWER({alias}.instrument) LIKE '%fabry%' "
                f"OR LOWER({alias}.instrument) LIKE '%fpi%')"
            )
            labels.append("Fabry-Perot/FPI instruments")

        if not clauses:
            return "", tuple(), "all indexed instruments"

        return " AND ".join(f"({x})" for x in clauses), tuple(params), " + ".join(labels)

    def _closest_availability_windows(
        self,
        product: Optional[Dict[str, object]],
        instrument_clause: str,
        instrument_params: Tuple[object, ...],
        limit: int = 8,
    ) -> List[tuple]:
        product_clause, product_params = self._availability_product_clause(product, "p")
        join_parameters = bool(product_clause)

        sql = """
            SELECT
                f.instrument_code_s,
                f.instrument,
                MIN(f.start_time_utc) AS first_time_utc,
                MAX(f.end_time_utc) AS last_time_utc,
                COUNT(DISTINCT f.file_index) AS file_count
            FROM files f
        """
        if join_parameters:
            sql += " JOIN parameters p ON p.file_index = f.file_index "

        where = ["f.start_time_utc IS NOT NULL", "f.end_time_utc IS NOT NULL"]
        params: List[object] = []

        if product_clause:
            where.append(product_clause)
            params.extend(product_params)

        if instrument_clause:
            where.append(instrument_clause)
            params.extend(instrument_params)

        sql += " WHERE " + " AND ".join(where)
        sql += """
            GROUP BY f.instrument_code_s, f.instrument
            ORDER BY file_count DESC, first_time_utc
            LIMIT ?
        """
        params.append(limit)

        return self._fetch_sql(sql, tuple(params))

    def _space_weather_coverage_summary(self) -> Tuple[str, str, int]:
        if not self._space_weather_ready():
            return "unknown", "unknown", 0
        rows = self._fetch_sql("SELECT MIN(date_utc), MAX(date_utc), COUNT(*) FROM sw.space_weather_daily")
        if not rows:
            return "unknown", "unknown", 0
        return str(rows[0][0]), str(rows[0][1]), int(rows[0][2] or 0)

    def _space_weather_filter_text(self, conditions: List[Dict[str, object]]) -> str:
        if not conditions:
            return "none"
        return " and ".join(
            f"{x['label']} {x['operator']} {float(x['value']):g}"
            for x in conditions
        )

    def _run_space_weather_query(self, query: str, limit: int) -> Optional[Message]:
        """Handle pure GFZ Kp/ap/Ap/F10.7/SN queries."""
        if not _has_space_weather_terms(query):
            return None

        q = _norm(query)
        product = _detect_availability_product(query)
        product_codes = {str(x).upper() for x in (product or {}).get("codes", [])}
        # A bare Kp mention can be detected by the legacy Madrigal mnemonic parser.
        # Do not mistake that for a request to join against Madrigal holdings.
        product_is_only_sw_mnemonic = bool(
            product
            and str(product.get("label", "")) == "requested Madrigal parameter(s)"
            and product_codes
            and product_codes.issubset({"KP"})
        )
        madrigal_product = None if product_is_only_sw_mnemonic else product
        instrument_clause, _, _ = self._availability_instrument_scope(query, "f")
        madrigal_nouns = bool(re.search(r"\b(?:madrigal|files?|datasets?|measurements?|experiments?|isr|radar|instrument)\b", q))
        if madrigal_product or instrument_clause or madrigal_nouns:
            return None

        if not self._space_weather_ready():
            return self._space_weather_missing_message(query)

        conditions = _extract_space_weather_conditions(query)
        if _needs_space_weather_threshold_clarification(query):
            return Message(text=(
                "[SQL Tool]\nNEEDS_SPACE_WEATHER_THRESHOLD\n\n"
                "MadVI will not invent a numeric definition for qualitative labels such as "
                "'high geomagnetic activity', 'storm', or 'quiet conditions'.\n\n"
                "Use an explicit criterion, for example Kp >= 5, daily Ap > 30, or F10.7obs > 150.\n\n"
                f"QUERY: {query}"
            ))

        window = _extract_sql_time_window(query)
        intent = _space_weather_intent(query)
        metric = _space_weather_metric(query)

        if intent == "latest" and not window:
            rows = self._fetch_sql(
                """
                SELECT date_utc, kp_max, kp_mean, ap_daily, ap_max,
                       sunspot_number, f107_obs, f107_adj, definitive_flag
                FROM sw.space_weather_daily
                ORDER BY date_utc DESC
                LIMIT 1
                """
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: space_weather_latest\n"
                f"QUERY: {query}\n\n"
                + self._format_rows(rows, [
                    "date_utc", "kp_max", "kp_mean", "Ap_daily", "ap_max",
                    "sunspot_number", "f107_obs", "f107_adj", "definitive_flag",
                ])
                + "\n\nDefinitive flag: 0=Kp and SN preliminary; 1=Kp definitive/SN preliminary; 2=Kp and SN definitive."
            ))

        if not window:
            start, end, count = self._space_weather_coverage_summary()
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\n"
                "Reason: a space-weather query was detected, but no supported calendar window was found.\n\n"
                "Examples:\n- What was Kp on 2024-05-11?\n- Which days in 2024 had Kp >= 5?\n"
                "- How many days in May 2024 had F10.7obs > 150?\n- What was the highest Kp in 2024?\n\n"
                f"Space-weather DB coverage: {start} through {end} ({count} daily rows).\nQUERY: {query}"
            ))

        start = str(window["start"])
        end = str(window["end"])
        cond_sql, cond_params = _space_weather_condition_sql(conditions, "sw")
        where = ["sw.date_utc >= DATE(?)", "sw.date_utc < DATE(?)"]
        params: List[object] = [start, end]
        if cond_sql:
            where.append(cond_sql)
            params.extend(cond_params)
        where_sql = " AND ".join(where)

        if window.get("granularity") == "day" and intent == "summary" and not conditions:
            daily = self._fetch_sql(
                f"""
                SELECT date_utc, kp_max, kp_mean, ap_daily, ap_max,
                       sunspot_number, f107_obs, f107_adj, definitive_flag
                FROM sw.space_weather_daily sw
                WHERE {where_sql}
                """,
                tuple(params),
            )
            intervals = self._fetch_sql(
                """
                SELECT interval_no, ut_interval, kp, ap
                FROM sw.space_weather_3hourly
                WHERE date_utc >= DATE(?) AND date_utc < DATE(?)
                ORDER BY interval_no
                """,
                (start, end),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: space_weather_day_detail\n"
                f"QUERY: {query}\n\nDaily summary:\n"
                + self._format_rows(daily, [
                    "date_utc", "kp_max", "kp_mean", "Ap_daily", "ap_max",
                    "sunspot_number", "f107_obs", "f107_adj", "definitive_flag",
                ])
                + "\n\n3-hour Kp/ap intervals (UT):\n"
                + self._format_rows(intervals, ["interval_no", "ut_interval", "Kp", "ap"])
                + "\n\nF10.7obs is used as the default F10.7 field for ionospheric/atmospheric queries."
            ))

        if intent == "count":
            rows = self._fetch_sql(f"SELECT COUNT(*) FROM sw.space_weather_daily sw WHERE {where_sql}", tuple(params))
            count = int(rows[0][0] or 0) if rows else 0
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: space_weather_count\n"
                f"QUERY: {query}\n\nMatching UTC days in {window['label']}: {count}\n"
                f"Space-weather filter: {self._space_weather_filter_text(conditions)}\n\n"
                "Source: attached GFZ space_weather.db. Documented missing sentinels were normalized to SQL NULL."
            ))

        if intent == "list_days":
            rows = self._fetch_sql(
                f"""
                SELECT date_utc, kp_max, kp_mean, ap_daily, ap_max,
                       f107_obs, sunspot_number, definitive_flag
                FROM sw.space_weather_daily sw
                WHERE {where_sql}
                ORDER BY date_utc
                LIMIT ?
                """,
                tuple(params) + (limit,),
            )
            total_rows = self._fetch_sql(f"SELECT COUNT(*) FROM sw.space_weather_daily sw WHERE {where_sql}", tuple(params))
            total = int(total_rows[0][0] or 0) if total_rows else 0
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: space_weather_day_list\n"
                f"QUERY: {query}\n\nTotal matching UTC days: {total}\n"
