    def _run_combined_space_weather_query(self, query: str, limit: int) -> Optional[Message]:
        """Join Madrigal file/day availability to GFZ daily indices by UTC date."""
        if not _has_space_weather_terms(query):
            return None

        q = _norm(query)
        product = _detect_availability_product(query)
        product_codes0 = {str(x).upper() for x in (product or {}).get("codes", [])}
        product_is_only_sw_mnemonic = bool(
            product
            and str(product.get("label", "")) == "requested Madrigal parameter(s)"
            and product_codes0
            and product_codes0.issubset({"KP"})
        )
        if product_is_only_sw_mnemonic:
            product = None

        product_clause, product_params = self._availability_product_clause(product, "p")
        instrument_clause, instrument_params, instrument_label = self._availability_instrument_scope(query, "f")
        conditions = _extract_space_weather_conditions(query)
        has_madrigal_scope = bool(
            product or instrument_clause
            or re.search(r"\b(?:madrigal|files?|datasets?|measurements?|experiments?)\b", q)
        )
        explicit_join_language = bool(
            "on days with" in q or "during days" in q or "days with" in q
            or "when kp" in q or "when ap" in q or "when f10.7" in q or "when f107" in q
        )
        join_requested = bool(conditions or product or instrument_clause or explicit_join_language)
        if not has_madrigal_scope or not join_requested:
            return None

        if not self._space_weather_ready():
            return self._space_weather_missing_message(query)

        if _needs_space_weather_threshold_clarification(query):
            return Message(text=(
                "[SQL Tool]\nNEEDS_SPACE_WEATHER_THRESHOLD\n\n"
                "This combined request uses a qualitative condition. MadVI will not silently decide what "
                "counts as a storm, high activity, or quiet conditions.\n\n"
                "Specify a numeric criterion, for example Kp >= 5, daily Ap > 30, or F10.7obs > 150.\n\n"
                f"QUERY: {query}"
            ))

        window = _extract_sql_time_window(query)
        if not window:
            return Message(text=(
                "[SQL Tool]\nNO_SUPPORTED_SQL_MODE\n\n"
                "Reason: combined Madrigal + space-weather joins require an explicit calendar window.\n\n"
                "Examples:\n- How many ISR electron-density days in 2024 had Kp >= 5?\n"
                "- Which Millstone Hill electron-density days in May 2024 had Kp > 6?\n"
                "- What was the maximum Kp on ISR electron-density days in August 2019?\n\n"
                f"QUERY: {query}"
            ))

        intent = _space_weather_intent(query)
        metric = _space_weather_metric(query)
        start = str(window["start"])
        end = str(window["end"])
        join_parameters = bool(product_clause)

        cte = """
            WITH RECURSIVE
            bounds AS (SELECT ? AS window_start, ? AS window_end),
            matching_files AS (
                SELECT DISTINCT
                    f.file_index, f.instrument, f.instrument_code_s,
                    f.start_time_utc, f.end_time_utc,
                    DATE(CASE WHEN f.start_time_utc < b.window_start THEN b.window_start ELSE f.start_time_utc END) AS start_day,
                    DATE(CASE
                        WHEN COALESCE(f.end_time_utc, f.start_time_utc) >= b.window_end
                            THEN strftime('%Y-%m-%dT%H:%M:%S+00:00', b.window_end, '-1 second')
                        ELSE COALESCE(f.end_time_utc, f.start_time_utc)
                    END) AS end_day
                FROM files f
                CROSS JOIN bounds b
        """
        if join_parameters:
            cte += " JOIN parameters p ON p.file_index = f.file_index "

        where = [
            "f.start_time_utc IS NOT NULL",
            "f.start_time_utc < b.window_end",
            "COALESCE(f.end_time_utc, f.start_time_utc) >= b.window_start",
        ]
        params: List[object] = [start, end]
        if product_clause:
            where.append(product_clause)
            params.extend(product_params)
        if instrument_clause:
            where.append(instrument_clause)
            params.extend(instrument_params)

        cte += " WHERE " + " AND ".join(where)
        cte += """
            ),
            recursive_days(file_index, instrument, instrument_code_s, day, end_day) AS (
                SELECT file_index, instrument, instrument_code_s, start_day, end_day
                FROM matching_files
                WHERE start_day IS NOT NULL AND end_day IS NOT NULL
                UNION ALL
                SELECT file_index, instrument, instrument_code_s, DATE(day, '+1 day'), end_day
                FROM recursive_days
                WHERE day < end_day
            ),
            daily_matches AS (
                SELECT rd.day AS date_utc,
                       COUNT(DISTINCT rd.file_index) AS file_count,
                       COUNT(DISTINCT rd.instrument_code_s || '|' || rd.instrument) AS instrument_count
                FROM recursive_days rd
                GROUP BY rd.day
            )
        """

        sw_clause, sw_params = _space_weather_condition_sql(conditions, "sw")
        joined_where_sql = (" WHERE " + sw_clause) if sw_clause else ""
        product_label = str(product["label"]) if product else "all matching Madrigal data"
        product_codes = ", ".join(str(x) for x in product.get("codes", [])) if product else "not restricted"

        coverage_rows = self._fetch_sql(
            cte + """
            SELECT COUNT(*) AS madrigal_days,
                   SUM(CASE WHEN sw.date_utc IS NOT NULL THEN 1 ELSE 0 END) AS days_with_space_weather
            FROM daily_matches dm
            LEFT JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
            """,
            tuple(params),
        )
        madrigal_days = int(coverage_rows[0][0] or 0) if coverage_rows else 0
        days_with_sw = int(coverage_rows[0][1] or 0) if coverage_rows else 0

        if madrigal_days == 0:
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: madrigal_space_weather_join\n"
                f"QUERY: {query}\n\nNo matching Madrigal-covered UTC days were found in {window['label']}.\n"
                f"Science product: {product_label}\nMatched parameter mnemonics/aliases: {product_codes}\n"
                f"Instrument scope: {instrument_label}\n\n"
                "Caveat: this applies only to the local MadVI headers index, not all Madrigal holdings."
            ))

        sw_coverage_note = (
            f"Space-weather rows were available for {days_with_sw} of {madrigal_days} matching Madrigal UTC days."
            if days_with_sw < madrigal_days
            else f"Space-weather rows were available for all {madrigal_days} matching Madrigal UTC days."
        )

        if intent == "list_files":
            file_rows = self._fetch_sql(
                cte + f"""
                SELECT DISTINCT rd.file_index, rd.instrument_code_s, rd.instrument,
                       mf.start_time_utc, mf.end_time_utc, rd.day AS qualifying_date,
                       sw.kp_max, sw.ap_daily, sw.f107_obs, sw.sunspot_number
                FROM recursive_days rd
                JOIN matching_files mf ON mf.file_index = rd.file_index
                JOIN sw.space_weather_daily sw ON sw.date_utc = rd.day
                {joined_where_sql}
                ORDER BY rd.day, rd.file_index
                LIMIT ?
                """,
                tuple(params) + tuple(sw_params) + (limit,),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: madrigal_space_weather_file_list\n"
                f"QUERY: {query}\n\nScience product: {product_label}\nInstrument scope: {instrument_label}\n"
                f"Space-weather filter: {self._space_weather_filter_text(conditions)}\n{sw_coverage_note}\n\n"
                + self._format_rows(file_rows, [
                    "file_index", "instrument_code_s", "instrument", "start_time_utc", "end_time_utc",
                    "qualifying_date", "kp_max", "Ap_daily", "f107_obs", "sunspot_number",
                ])
            ))

        count_rows = self._fetch_sql(
            cte + f"""
            SELECT COUNT(DISTINCT dm.date_utc) AS matching_days,
                   MIN(dm.date_utc) AS first_day, MAX(dm.date_utc) AS last_day
            FROM daily_matches dm
            JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
            {joined_where_sql}
            """,
            tuple(params) + tuple(sw_params),
        )
        matching_days = int(count_rows[0][0] or 0) if count_rows else 0

        distinct_file_rows = self._fetch_sql(
            cte + f"""
            SELECT COUNT(DISTINCT rd.file_index)
            FROM recursive_days rd
            JOIN sw.space_weather_daily sw ON sw.date_utc = rd.day
            {joined_where_sql}
            """,
            tuple(params) + tuple(sw_params),
        )
        matching_files = int(distinct_file_rows[0][0] or 0) if distinct_file_rows else 0

        if intent == "count":
            availability_metric = _availability_metric(query)
            lead = (
                f"Matching indexed files: {matching_files}"
                if availability_metric == "files"
                else f"Matching distinct UTC days: {matching_days}"
            )
            count_details = (
                f"Matching distinct UTC days: {matching_days}\n"
                if availability_metric == "files"
                else f"Matching distinct indexed files: {matching_files}\n"
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: madrigal_space_weather_count\n"
                f"QUERY: {query}\n\n{lead}\n{count_details}"
                f"Science product: {product_label}\n"
                f"Matched parameter mnemonics/aliases: {product_codes}\nInstrument scope: {instrument_label}\n"
                f"Time window: {window['label']}\nSpace-weather filter: {self._space_weather_filter_text(conditions)}\n"
                f"{sw_coverage_note}\n\n"
                "Join logic: Madrigal file coverage was expanded to UTC calendar days and joined to GFZ space_weather_daily by date_utc."
            ))

        if intent == "list_days":
            rows = self._fetch_sql(
                cte + f"""
                SELECT dm.date_utc, dm.file_count, dm.instrument_count,
                       sw.kp_max, sw.kp_mean, sw.ap_daily, sw.ap_max,
                       sw.f107_obs, sw.sunspot_number, sw.definitive_flag
                FROM daily_matches dm
                JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
                {joined_where_sql}
                ORDER BY dm.date_utc
                LIMIT ?
                """,
                tuple(params) + tuple(sw_params) + (limit,),
            )
            return Message(text=(
                "[SQL Tool]\n[SQL Retrieval]\nTOOL_NAME: madvi_router_executor_v4\n"
                "INTERNAL_ROUTE: HEADERS_SQL\nMODE: madrigal_space_weather_day_list\n"
                f"QUERY: {query}\n\nTotal matching distinct UTC days: {matching_days}\nScience product: {product_label}\n"
                f"Instrument scope: {instrument_label}\nSpace-weather filter: {self._space_weather_filter_text(conditions)}\n"
                f"{sw_coverage_note}\nShowing up to {limit} rows:\n\n"
                + self._format_rows(rows, [
                    "date_utc", "file_count", "instrument_count", "kp_max", "kp_mean",
                    "Ap_daily", "ap_max", "f107_obs", "sunspot_number", "definitive_flag",
                ])
            ))

        metric = metric or {"column": "kp_max", "label": "maximum daily Kp", "units": "index"}
        column = metric["column"]
        label = metric["label"]

        if intent in {"max", "min"}:
            direction = "DESC" if intent == "max" else "ASC"
            extra_predicate = f"sw.{column} IS NOT NULL"
            predicate = (sw_clause + " AND " + extra_predicate) if sw_clause else extra_predicate
            rows = self._fetch_sql(
                cte + f"""
                SELECT dm.date_utc, dm.file_count, sw.{column} AS requested_value,
                       sw.ap_daily, sw.f107_obs, sw.sunspot_number, sw.definitive_flag
                FROM daily_matches dm
                JOIN sw.space_weather_daily sw ON sw.date_utc = dm.date_utc
                WHERE {predicate}
                ORDER BY sw.{column} {direction}, dm.date_utc
                LIMIT ?
                """,
                tuple(params) + tuple(sw_params) + (limit,),
